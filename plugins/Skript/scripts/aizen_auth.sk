# =========================================================
# AizenSMP - Custom Authentication
# Replaces AuthMe Reloaded
# Purpur 1.21.11 / Skript
# =========================================================

options:
    auth-prefix: &6[&eAizenSMP&6] &r
    auth-timeout: 60 seconds
    min-password: 6

# Passwords are stored in the server's Skript variables.
# /register <password> <password>
# /login <password>
# /changepassword <old> <new>

on join:
    set {az.auth.logged.%uuid of player%} to false
    set {az.auth.failed.%uuid of player%} to 0

    if {az.auth.password.%uuid of player%} is not set:
        send "" to player
        send "{@auth-prefix}&e&lACCOUNT NOT REGISTERED" to player
        send "&fUse: &a/register <password> <password>" to player
    else:
        send "" to player
        send "{@auth-prefix}&e&lLOGIN REQUIRED" to player
        send "&fUse: &a/login <password>" to player

    wait {@auth-timeout}
    if player is online:
        if {az.auth.logged.%uuid of player%} is not true:
            kick player due to "&cLogin timeout.&r Please rejoin and login."

command /register <text> <text>:
    trigger:
        if {az.auth.logged.%uuid of player%} is true:
            send "{@auth-prefix}&cYou are already logged in."
            stop

        if {az.auth.password.%uuid of player%} is set:
            send "{@auth-prefix}&cThis account is already registered."
            send "&7Use &e/login <password>&7."
            stop

        if length of arg-1 < {@min-password}:
            send "{@auth-prefix}&cPassword must be at least {@min-password} characters."
            stop

        if arg-1 is not arg-2:
            send "{@auth-prefix}&cPasswords do not match."
            stop

        set {az.auth.password.%uuid of player%} to arg-1
        set {az.auth.logged.%uuid of player%} to true
        delete {az.auth.failed.%uuid of player%}
        send "{@auth-prefix}&aRegistration successful!"
        send "{@auth-prefix}&aYou are now logged in."

command /login <text>:
    trigger:
        if {az.auth.logged.%uuid of player%} is true:
            send "{@auth-prefix}&cYou are already logged in."
            stop

        if {az.auth.password.%uuid of player%} is not set:
            send "{@auth-prefix}&cYou are not registered."
            send "&7Use &e/register <password> <password>&7."
            stop

        if arg-1 is not {az.auth.password.%uuid of player%}:
            add 1 to {az.auth.failed.%uuid of player%}
            if {az.auth.failed.%uuid of player%} >= 5:
                kick player due to "&cToo many failed login attempts."
                stop
            send "{@auth-prefix}&cWrong password. &7Attempt %{az.auth.failed.%uuid of player%}%/5."
            stop

        delete {az.auth.failed.%uuid of player%}
        set {az.auth.logged.%uuid of player%} to true
        send "{@auth-prefix}&aLogin successful. Welcome back!"

command /changepassword <text> <text>:
    aliases: /changepass
    trigger:
        if {az.auth.logged.%uuid of player%} is not true:
            send "{@auth-prefix}&cYou must login first."
            stop

        if length of arg-2 < {@min-password}:
            send "{@auth-prefix}&cNew password must be at least {@min-password} characters."
            stop

        if arg-1 is not {az.auth.password.%uuid of player%}:
            send "{@auth-prefix}&cCurrent password is incorrect."
            stop

        if arg-2 is arg-1:
            send "{@auth-prefix}&cNew password must be different."
            stop

        set {az.auth.password.%uuid of player%} to arg-2
        send "{@auth-prefix}&aPassword changed successfully."

command /unregister <player>:
    permission: aizensmp.admin
    trigger:
        delete {az.auth.password.%uuid of arg-1%}
        delete {az.auth.logged.%uuid of arg-1%}
        delete {az.auth.failed.%uuid of arg-1%}
        send "{@auth-prefix}&aAccount data reset for &e%arg-1%&a."

on quit:
    delete {az.auth.logged.%uuid of player%}

# Block gameplay until authenticated.
on chat:
    if {az.auth.logged.%uuid of player%} is not true:
        cancel event
        send "{@auth-prefix}&cLogin first: &e/login <password>" to player

on command:
    if {az.auth.logged.%uuid of player%} is not true:
        if command is not "login":
            if command is not "register":
                cancel event
                send "{@auth-prefix}&cLogin first: &e/login <password>" to player

on move:
    if {az.auth.logged.%uuid of player%} is not true:
        cancel event

on damage:
    if attacker is a player:
        if {az.auth.logged.%uuid of attacker%} is not true:
            cancel event
    if victim is a player:
        if {az.auth.logged.%uuid of victim%} is not true:
            cancel event

on block break:
    if {az.auth.logged.%uuid of player%} is not true:
        cancel event

on block place:
    if {az.auth.logged.%uuid of player%} is not true:
        cancel event

on inventory click:
    if {az.auth.logged.%uuid of player%} is not true:
        cancel event

on drop:
    if {az.auth.logged.%uuid of player%} is not true:
        cancel event

on pickup:
    if {az.auth.logged.%uuid of player%} is not true:
        cancel event

on consume:
    if {az.auth.logged.%uuid of player%} is not true:
        cancel event

on interact:
    if {az.auth.logged.%uuid of player%} is not true:
        cancel event
