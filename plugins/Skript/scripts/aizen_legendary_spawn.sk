# =========================================================
# AIZEN SMP - DONUT SMP STYLE SPAWN
# Very large 1001x1001 survival-SMP hub inspired by the visual language of Donut-style spawns.
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r

function azBuildLegendarySpawn(p: player):
    set {az.spawn} to location of {_p}
    set {az.afk} to location of {_p}
    set {az.duel} to location of {_p}
    delete {az.spawn.built}
    delete {az.bots.ready}

    # Clear a large 1001 x 1001 x 30 build volume.
    execute console command "execute at %{_p}% run fill ~-500 ~-3 ~-500 ~500 ~25 ~500 air"

    # Donut-style circular foundation: dark stone, white trim and gold accents.
    execute console command "execute at %{_p}% run fill ~-500 ~-2 ~-500 ~500 ~-2 ~500 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-487 ~-1 ~-487 ~487 ~-1 ~487 blackstone"
    execute console command "execute at %{_p}% run fill ~-473 ~0 ~-473 ~473 ~0 ~473 smooth_quartz"

    # Wide radial roads from the central hub.
    execute console command "execute at %{_p}% run fill ~-487 ~0 ~-10 ~487 ~0 ~10 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-10 ~0 ~-487 ~10 ~0 ~487 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-10 ~1 ~-487 ~10 ~1 ~487 gold_block"
    execute console command "execute at %{_p}% run fill ~-487 ~1 ~-10 ~487 ~1 ~10 gold_block"

    # Four secondary diagonal roads create the familiar radial hub layout.
    execute console command "execute at %{_p}% run fill ~-450 ~0 ~-460 ~-433 ~0 ~-143 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~433 ~0 ~-460 ~450 ~0 ~-143 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-450 ~0 ~143 ~-433 ~0 ~460 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~433 ~0 ~143 ~450 ~0 ~460 polished_blackstone"

    # Large circular-looking central plaza made from nested square rings.
    execute console command "execute at %{_p}% run fill ~-40 ~1 ~-40 ~40 ~1 ~40 black_concrete"
    execute console command "execute at %{_p}% run fill ~-36 ~2 ~-36 ~36 ~2 ~36 quartz_block"
    execute console command "execute at %{_p}% run fill ~-30 ~3 ~-30 ~30 ~3 ~30 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-22 ~4 ~-22 ~22 ~4 ~22 smooth_quartz"
    execute console command "execute at %{_p}% run fill ~-14 ~5 ~-14 ~14 ~5 ~14 gold_block"
    execute console command "execute at %{_p}% run fill ~-6 ~6 ~-6 ~6 ~6 ~6 beacon"

    # Raised central monument and four low corner plinths.
    execute console command "execute at %{_p}% run fill ~-10 ~7 ~-10 ~10 ~13 ~10 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-6 ~14 ~-6 ~6 ~17 ~6 gold_block"
    execute console command "execute at %{_p}% run setblock ~0 ~18 ~0 beacon"
    execute console command "execute at %{_p}% run fill ~-93 ~2 ~-24 ~-36 ~4 ~-4 blackstone"
    execute console command "execute at %{_p}% run fill ~36 ~2 ~-24 ~93 ~4 ~-4 blackstone"
    execute console command "execute at %{_p}% run fill ~-93 ~2 ~4 ~-36 ~4 ~24 blackstone"
    execute console command "execute at %{_p}% run fill ~36 ~2 ~4 ~93 ~4 ~24 blackstone"

    # Enclosed spawn perimeter: tall protected blackstone walls with four controlled entrances.
    execute console command "execute at %{_p}% run fill ~-500 ~0 ~-500 ~500 ~10 ~-500 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-500 ~0 ~500 ~500 ~10 ~500 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-500 ~0 ~-500 ~-500 ~10 ~500 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~500 ~0 ~-500 ~500 ~10 ~500 polished_blackstone_bricks"
    # Four entrance openings.
    execute console command "execute at %{_p}% run fill ~-10 ~0 ~-500 ~10 ~6 ~-497 air"
    execute console command "execute at %{_p}% run fill ~-10 ~0 ~497 ~10 ~6 ~500 air"
    execute console command "execute at %{_p}% run fill ~-500 ~0 ~-10 ~-497 ~6 ~10 air"
    execute console command "execute at %{_p}% run fill ~497 ~0 ~-10 ~500 ~6 ~10 air"
    # Gold gate frames.
    execute console command "execute at %{_p}% run fill ~-14 ~0 ~-503 ~14 ~7 ~-503 gold_block outline"
    execute console command "execute at %{_p}% run fill ~-14 ~0 ~503 ~14 ~7 ~503 gold_block outline"
    execute console command "execute at %{_p}% run fill ~503 ~0 ~-14 ~503 ~7 ~14 gold_block outline"
    execute console command "execute at %{_p}% run fill ~-503 ~0 ~-14 ~-503 ~7 ~14 gold_block outline"

    # Donut-style outer landmark towers.
    execute console command "execute at %{_p}% run fill ~-460 ~0 ~-460 ~-427 ~18 ~-427 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~427 ~0 ~-460 ~460 ~18 ~-427 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-460 ~0 ~427 ~-427 ~18 ~460 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~427 ~0 ~427 ~460 ~18 ~460 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-467 ~19 ~-467 ~-420 ~20 ~-420 gold_block"
    execute console command "execute at %{_p}% run fill ~420 ~19 ~-467 ~467 ~20 ~-420 gold_block"
    execute console command "execute at %{_p}% run fill ~-467 ~19 ~420 ~-420 ~20 ~467 gold_block"
    execute console command "execute at %{_p}% run fill ~420 ~19 ~420 ~467 ~20 ~467 gold_block"

    # Four monumental radial entrance arches.
    execute console command "execute at %{_p}% run fill ~-16 ~0 ~-480 ~-4 ~12 ~-460 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~4 ~0 ~-480 ~16 ~12 ~-460 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-16 ~0 ~460 ~-4 ~12 ~480 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~4 ~0 ~460 ~16 ~12 ~480 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-480 ~0 ~-16 ~-460 ~12 ~-4 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~460 ~0 ~-16 ~480 ~12 ~-4 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-480 ~0 ~4 ~-460 ~12 ~16 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~460 ~0 ~4 ~480 ~12 ~16 polished_blackstone_bricks"

    # Royal lighting ring.
    execute console command "execute at %{_p}% run fill ~-40 ~3 ~-40 ~40 ~3 ~40 gold_block outline"
    execute console command "execute at %{_p}% run fill ~-38 ~4 ~-38 ~38 ~4 ~38 sea_lantern outline"

    # Decorative pillars and lights.
    execute console command "execute at %{_p}% run fill ~-100 ~1 ~-100 ~-93 ~10 ~-93 blackstone"
    execute console command "execute at %{_p}% run fill ~93 ~1 ~-100 ~100 ~10 ~-93 blackstone"
    execute console command "execute at %{_p}% run fill ~-100 ~1 ~93 ~-93 ~10 ~100 blackstone"
    execute console command "execute at %{_p}% run fill ~93 ~1 ~93 ~100 ~10 ~100 blackstone"
    execute console command "execute at %{_p}% run setblock ~-97 ~11 ~-97 sea_lantern"
    execute console command "execute at %{_p}% run setblock ~97 ~11 ~-97 sea_lantern"
    execute console command "execute at %{_p}% run setblock ~-97 ~11 ~97 sea_lantern"
    execute console command "execute at %{_p}% run setblock ~97 ~11 ~97 sea_lantern"

    # Four service platforms for the command bots around the central hub.
    execute console command "execute at %{_p}% run fill ~-40 ~2 ~-24 ~-20 ~3 ~-8 gold_block"
    execute console command "execute at %{_p}% run fill ~20 ~2 ~-24 ~40 ~3 ~-8 gold_block"
    execute console command "execute at %{_p}% run fill ~-40 ~2 ~8 ~-20 ~3 ~24 gold_block"
    execute console command "execute at %{_p}% run fill ~20 ~2 ~8 ~40 ~3 ~24 gold_block"

    # AIZEN crown at the back of the hub.
    execute console command "execute at %{_p}% run fill ~-20 ~4 ~93 ~20 ~4 ~93 gold_block"
    execute console command "execute at %{_p}% run fill ~-14 ~5 ~93 ~14 ~9 ~93 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-8 ~10 ~93 ~8 ~12 ~93 gold_block"

    set {az.spawn.built} to true
    set {az.afk} to location of {_p}
    set {az.duel} to location of {_p}
    send "{@prefix}&aتم بناء الـSpawn الأسطوري الكبير." to {_p}
    send "{@prefix}&7المركز: &f%{az.spawn}%" to {_p}
    send "{@prefix}&eاستخدم /setupbots لإعادة وضع البوتات حول الساحة." to {_p}

command /builddonutspawn:
    permission: aizensmp.admin
    aliases: /buildlegendaryspawn
    trigger:
        azBuildLegendarySpawn(player)

# IMPORTANT: Never build the spawn at a joining player's location.
# If the persistent Skript variable is missing, fall back to the world's own spawn.
# This prevents a restart/persistence glitch from turning an underground player location
# into the permanent server spawn.
on load:
    # One-time migration from the old random/underground spawn behavior.
    # Use the world's actual spawn and move to the highest safe block.
    if {az.spawn.migration.v2} is not true:
        set {_w} to world "world"
        if {_w} is set:
            set {_base} to spawn location of {_w}
            set {_safe} to highest block at {_base}
            add 1 to y-coordinate of {_safe}
            set {az.spawn} to {_safe}
            set {az.afk} to {_safe}
            set {az.duel} to {_safe}
            delete {az.spawn.built}
            set {az.spawn.migration.v2} to true

    if {az.spawn} is not set:
        set {_w} to world "world"
        if {_w} is set:
            set {az.spawn} to spawn location of {_w}
            set {az.afk} to {az.spawn}
            set {az.duel} to {az.spawn}

on join:
    if {az.spawn} is not set:
        set {_w} to world "world"
        if {_w} is set:
            set {_base} to spawn location of {_w}
            set {_safe} to highest block at {_base}
            add 1 to y-coordinate of {_safe}
            set {az.spawn} to {_safe}
            set {az.afk} to {_safe}
            set {az.duel} to {_safe}
    # If an old persisted spawn is underground, repair it instead of teleporting players there.
    if y-coordinate of {az.spawn} < -60:
        set {_w} to world "world"
        if {_w} is set:
            set {_base} to spawn location of {_w}
            set {_safe} to highest block at {_base}
            add 1 to y-coordinate of {_safe}
            set {az.spawn} to {_safe}
            set {az.afk} to {_safe}
            set {az.duel} to {_safe}
    # Do not auto-build a 1001x1001 spawn because a player joined.
    # Spawn construction is manual via /builddonutspawn.
