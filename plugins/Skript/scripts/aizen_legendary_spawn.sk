# =========================================================
# AIZEN SMP - DONUT SMP STYLE SPAWN
# Very large 241x241 survival-SMP hub inspired by the visual language of Donut-style spawns.
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r

function azBuildLegendarySpawn(p: player):
    set {az.spawn} to location of {_p}
    set {az.afk} to location of {_p}
    set {az.duel} to location of {_p}
    delete {az.spawn.built}
    delete {az.bots.ready}

    # Clear a large 241 x 241 x 30 build volume.
    execute console command "execute at %{_p}% run fill ~-300 ~-3 ~-300 ~300 ~25 ~300 air"

    # Donut-style circular foundation: dark stone, white trim and gold accents.
    execute console command "execute at %{_p}% run fill ~-300 ~-2 ~-300 ~300 ~-2 ~300 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-292 ~-1 ~-292 ~292 ~-1 ~292 blackstone"
    execute console command "execute at %{_p}% run fill ~-284 ~0 ~-284 ~284 ~0 ~284 smooth_quartz"

    # Wide radial roads from the central hub.
    execute console command "execute at %{_p}% run fill ~-292 ~0 ~-10 ~292 ~0 ~10 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-10 ~0 ~-292 ~10 ~0 ~292 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-10 ~1 ~-292 ~10 ~1 ~292 gold_block"
    execute console command "execute at %{_p}% run fill ~-292 ~1 ~-10 ~292 ~1 ~10 gold_block"

    # Four secondary diagonal roads create the familiar radial hub layout.
    execute console command "execute at %{_p}% run fill ~-270 ~0 ~-276 ~-260 ~0 ~-86 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~260 ~0 ~-276 ~270 ~0 ~-86 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-270 ~0 ~86 ~-260 ~0 ~276 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~260 ~0 ~86 ~270 ~0 ~276 polished_blackstone"

    # Large circular-looking central plaza made from nested square rings.
    execute console command "execute at %{_p}% run fill ~-40 ~1 ~-40 ~40 ~1 ~40 black_concrete"
    execute console command "execute at %{_p}% run fill ~-36 ~2 ~-36 ~36 ~2 ~36 quartz_block"
    execute console command "execute at %{_p}% run fill ~-30 ~3 ~-30 ~30 ~3 ~30 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-22 ~4 ~-22 ~22 ~4 ~22 smooth_quartz"
    execute console command "execute at %{_p}% run fill ~-14 ~5 ~-14 ~14 ~5 ~14 gold_block"
    execute console command "execute at %{_p}% run fill ~-6 ~6 ~-6 ~6 ~6 ~6 beacon"

    # Raised central monument and four low corner plinths.
    execute console command "execute at %{_p}% run fill ~-10 ~7 ~-10 ~10 ~13 ~10 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-6 ~14 ~-6 ~6 ~17 ~6 gold_block"
    execute console command "execute at %{_p}% run setblock ~0 ~18 ~0 beacon"
    execute console command "execute at %{_p}% run fill ~-56 ~2 ~-24 ~-36 ~4 ~-4 blackstone"
    execute console command "execute at %{_p}% run fill ~36 ~2 ~-24 ~56 ~4 ~-4 blackstone"
    execute console command "execute at %{_p}% run fill ~-56 ~2 ~4 ~-36 ~4 ~24 blackstone"
    execute console command "execute at %{_p}% run fill ~36 ~2 ~4 ~56 ~4 ~24 blackstone"

    # Enclosed spawn perimeter: tall protected blackstone walls with four controlled entrances.
    execute console command "execute at %{_p}% run fill ~-300 ~0 ~-300 ~300 ~10 ~-300 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-300 ~0 ~300 ~300 ~10 ~300 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-300 ~0 ~-300 ~-300 ~10 ~300 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~300 ~0 ~-300 ~300 ~10 ~300 polished_blackstone_bricks"
    # Four entrance openings.
    execute console command "execute at %{_p}% run fill ~-10 ~0 ~-300 ~10 ~6 ~-298 air"
    execute console command "execute at %{_p}% run fill ~-10 ~0 ~298 ~10 ~6 ~300 air"
    execute console command "execute at %{_p}% run fill ~-300 ~0 ~-10 ~-298 ~6 ~10 air"
    execute console command "execute at %{_p}% run fill ~298 ~0 ~-10 ~300 ~6 ~10 air"
    # Gold gate frames.
    execute console command "execute at %{_p}% run fill ~-14 ~0 ~-302 ~14 ~7 ~-302 gold_block outline"
    execute console command "execute at %{_p}% run fill ~-14 ~0 ~302 ~14 ~7 ~302 gold_block outline"
    execute console command "execute at %{_p}% run fill ~302 ~0 ~-14 ~302 ~7 ~14 gold_block outline"
    execute console command "execute at %{_p}% run fill ~-302 ~0 ~-14 ~-302 ~7 ~14 gold_block outline"

    # Donut-style outer landmark towers.
    execute console command "execute at %{_p}% run fill ~-276 ~0 ~-276 ~-256 ~18 ~-256 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~256 ~0 ~-276 ~276 ~18 ~-256 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-276 ~0 ~256 ~-256 ~18 ~276 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~256 ~0 ~256 ~276 ~18 ~276 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-280 ~19 ~-280 ~-252 ~20 ~-252 gold_block"
    execute console command "execute at %{_p}% run fill ~252 ~19 ~-280 ~280 ~20 ~-252 gold_block"
    execute console command "execute at %{_p}% run fill ~-280 ~19 ~252 ~-252 ~20 ~280 gold_block"
    execute console command "execute at %{_p}% run fill ~252 ~19 ~252 ~280 ~20 ~280 gold_block"

    # Four monumental radial entrance arches.
    execute console command "execute at %{_p}% run fill ~-16 ~0 ~-288 ~-4 ~12 ~-276 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~4 ~0 ~-288 ~16 ~12 ~-276 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-16 ~0 ~276 ~-4 ~12 ~288 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~4 ~0 ~276 ~16 ~12 ~288 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-288 ~0 ~-16 ~-276 ~12 ~-4 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~276 ~0 ~-16 ~288 ~12 ~-4 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-288 ~0 ~4 ~-276 ~12 ~16 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~276 ~0 ~4 ~288 ~12 ~16 polished_blackstone_bricks"

    # Royal lighting ring.
    execute console command "execute at %{_p}% run fill ~-40 ~3 ~-40 ~40 ~3 ~40 gold_block outline"
    execute console command "execute at %{_p}% run fill ~-38 ~4 ~-38 ~38 ~4 ~38 sea_lantern outline"

    # Decorative pillars and lights.
    execute console command "execute at %{_p}% run fill ~-60 ~1 ~-60 ~-56 ~10 ~-56 blackstone"
    execute console command "execute at %{_p}% run fill ~56 ~1 ~-60 ~60 ~10 ~-56 blackstone"
    execute console command "execute at %{_p}% run fill ~-60 ~1 ~56 ~-56 ~10 ~60 blackstone"
    execute console command "execute at %{_p}% run fill ~56 ~1 ~56 ~60 ~10 ~60 blackstone"
    execute console command "execute at %{_p}% run setblock ~-58 ~11 ~-58 sea_lantern"
    execute console command "execute at %{_p}% run setblock ~58 ~11 ~-58 sea_lantern"
    execute console command "execute at %{_p}% run setblock ~-58 ~11 ~58 sea_lantern"
    execute console command "execute at %{_p}% run setblock ~58 ~11 ~58 sea_lantern"

    # Four service platforms for the command bots around the central hub.
    execute console command "execute at %{_p}% run fill ~-40 ~2 ~-24 ~-20 ~3 ~-8 gold_block"
    execute console command "execute at %{_p}% run fill ~20 ~2 ~-24 ~40 ~3 ~-8 gold_block"
    execute console command "execute at %{_p}% run fill ~-40 ~2 ~8 ~-20 ~3 ~24 gold_block"
    execute console command "execute at %{_p}% run fill ~20 ~2 ~8 ~40 ~3 ~24 gold_block"

    # AIZEN crown at the back of the hub.
    execute console command "execute at %{_p}% run fill ~-20 ~4 ~56 ~20 ~4 ~56 gold_block"
    execute console command "execute at %{_p}% run fill ~-14 ~5 ~56 ~14 ~9 ~56 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-8 ~10 ~56 ~8 ~12 ~56 gold_block"

    set {az.spawn.built} to true
    set {az.afk} to location of {_p}
    set {az.duel} to location of {_p}
    send "{@prefix}&aتم بناء الـSpawn الأسطوري الكبير." to {_p}
    send "{@prefix}&7المركز: &f%{az.spawn}%" to {_p}
    send "{@prefix}&eاستخدم /setupbots لإعادة وضع البوتات حول الساحة." to {_p}

command /builddonutspawn:
    permission: aizensmp.admin
    aliases: /buildlegendaryspawn
    trigger:
        azBuildLegendarySpawn(player)

on join:
    if {az.spawn} is not set:
        set {az.spawn} to location of player
        set {az.afk} to location of player
        set {az.duel} to location of player
    if {az.spawn.built} is not true:
        wait 2 seconds
        if player is online:
            azBuildLegendarySpawn(player)
