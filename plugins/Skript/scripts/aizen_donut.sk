# =========================================================
# AizenSMP - Donut-style Spawn + Utilities
# Purpur 1.21.11 / Skript
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r
    spawn-radius: 250

# ---------------- QUICK COMMANDS ----------------

command /wild:
    aliases: /wilderness, /random
    trigger:
        make player execute command "/rtp"

command /sellall:
    trigger:
        set {_sold} to 0
        set {_total} to 0
        loop all items in player's inventory:
            if loop-item is not air:
                set {_price} to {az.sellprice.%type of loop-item%}
                if {_price} is set:
                    set {_amount} to amount of loop-item
                    add {_amount} to {_sold}
                    add ({_price} * {_amount}) to {_total}
                    remove loop-item from player's inventory
        if {_sold} <= 0:
            send "{@prefix}&cلا يوجد شيء قابل للبيع في حقيبتك."
            stop
        add {_total} to {az.money.%uuid of player%}
        send "{@prefix}&aبعت &e%{_sold}% &aقطعة مقابل &6$%{_total}%&a."

command /trash:
    trigger:
        open chest inventory with 6 rows named "&8✦ &cTRASH &8✦" to player

on inventory close:
    if name of event-inventory is "&8✦ &cTRASH &8✦":
        loop all items in event-inventory:
            if loop-item is not air:
                delete loop-item

command /near:
    trigger:
        set {_found} to false
        loop all players:
            if loop-player is not player:
                if distance between player and loop-player <= 100:
                    set {_found} to true
                    send "&7• &e%loop-player% &7- &f%round(distance between player and loop-player)% blocks"
        if {_found} is false:
            send "{@prefix}&7لا يوجد لاعب قريب ضمن 100 بلوك."

command /ping:
    trigger:
        send "{@prefix}&fPing: &e%ping of player%ms"

command /suicide:
    trigger:
        kill player

# ---------------- SPAWN BUILDER ----------------
# Spawn construction is handled only by aizen_legendary_spawn.sk.
# This file intentionally keeps only the Donut utility commands/protection,
# avoiding duplicate /builddonutspawn handlers and automatic rebuilding on join.

# Players cannot walk out of the protected hub.
# Leaving is only possible through approved teleport commands.
on player move:
    if {az.spawn} is set:
        if distance between location of player and {az.spawn} <= {@spawn-radius}:
            if distance between event-location and {az.spawn} > {@spawn-radius}:
                cancel event
                send action bar "&c✘ لا يمكنك مغادرة الـSpawn سيراً &7- استخدم &e/rtp &7أو &e/tpa" to player
                stop
        else:
            if {az.spawn.lock.%uuid of player%} is true:
                cancel event
                delete {az.spawn.lock.%uuid of player%}

# Mark approved teleports outside the spawn.
on teleport:
    if {az.spawn} is set:
        if {az.spawn.lock.%uuid of player%} is true:
            stop
        if distance between event-location and {az.spawn} > {@spawn-radius}:
            # Normal plugin/command teleports are allowed.
            stop

on quit:
    delete {az.spawn.lock.%uuid of player%}

# ---------------- SPAWN PROTECTION ----------------

on block break:
    if {az.spawn} is set:
        if distance between location of event-block and {az.spawn} <= {@spawn-radius}:
            cancel event
            send "{@prefix}&cلا يمكنك كسر أي بلوك داخل الـSpawn."
            stop
    if {az.afk} is set:
        if distance between location of event-block and {az.afk} <= 15:
            cancel event

on block place:
    if {az.spawn} is set:
        if distance between location of event-block and {az.spawn} <= {@spawn-radius}:
            cancel event
            send "{@prefix}&cلا يمكنك البناء داخل الـSpawn."
            stop
    if {az.afk} is set:
        if distance between location of event-block and {az.afk} <= 15:
            cancel event

on damage:
    if victim is a player:
        if {az.spawn} is set:
            if distance between location of victim and {az.spawn} <= {@spawn-radius}:
                cancel event
                stop
        if {az.afk} is set:
            if distance between location of victim and {az.afk} <= 15:
                cancel event
                stop

on explode:
    if {az.spawn} is set:
        if distance between event-location and {az.spawn} <= {@spawn-radius}:
            cancel event
            stop
    if {az.afk} is set:
        if distance between event-location and {az.afk} <= 15:
            cancel event
