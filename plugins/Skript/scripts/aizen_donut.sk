# =========================================================
# AizenSMP - DONUT SMP READY LAYER
# Purpur 1.21.11 / Skript
# Custom systems only - no external gameplay plugins.
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r

# Donut-style quick RTP alias.
command /wild:
    aliases: /wilderness, /random
    trigger:
        execute player command "/rtp"

# Donut-style sell-all: sells every item in the player's inventory
# using the prices configured by the existing AizenSMP sell system.
command /sellall:
    trigger:
        set {_sold} to 0
        set {_total} to 0
        loop all items in player's inventory:
            if loop-item is not air:
                set {_price} to {az.sellprice.%type of loop-item%}
                if {_price} is set:
                    set {_amount} to amount of loop-item
                    add {_amount} to {_sold}
                    add ({_price} * {_amount}) to {_total}
                    remove loop-item from player's inventory
        if {_sold} <= 0:
            send "{@prefix} &cلا يوجد شيء قابل للبيع في حقيبتك."
            stop
        add {_total} to {az.money.%uuid of player%}
        send "{@prefix} &aبعت &e%{_sold}% &aقطعة مقابل &6$%{_total}%&a."

# Quick trash command.
command /trash:
    trigger:
        set {_trash} to chest inventory with 6 rows named "&8✦ &cTRASH &8✦"
        open {_trash} to player

on inventory click:
    if name of event-inventory is "&8✦ &cTRASH &8✦":
        stop

on inventory close:
    if name of event-inventory is "&8✦ &cTRASH &8✦":
        loop all items in event-inventory:
            if loop-item is not air:
                delete loop-item

# Show nearby players.
command /near:
    trigger:
        set {_found} to false
        loop all players:
            if loop-player is not player:
                if distance between player and loop-player <= 100:
                    set {_found} to true
                    send "&7• &e%loop-player% &7- &f%round(distance between player and loop-player)% blocks"
        if {_found} is false:
            send "{@prefix} &7لا يوجد لاعب قريب ضمن 100 بلوك."

# Ping.
command /ping:
    trigger:
        send "{@prefix} &fPing: &e%ping of player%ms"

# Donut-style death/respawn convenience.
command /suicide:
    trigger:
        kill player


# =========================================================
# DONUT-STYLE SPAWN BUILDER + PROTECTION
# Run /builddonutspawn once at the desired spawn location.
# =========================================================

command /builddonutspawn:
    permission: aizensmp.admin
    trigger:
        set {az.donutspawn} to location of player
        set {az.spawn} to location of player
        send "{@prefix} &eBuilding Donut-style spawn... &7Do not move."
        execute console command "execute at %player% run fill ~-35 ~-1 ~-35 ~35 ~-1 ~35 polished_deepslate"
        execute console command "execute at %player% run fill ~-31 ~0 ~-31 ~31 ~0 ~31 stone_bricks"
        execute console command "execute at %player% run fill ~-27 ~1 ~-27 ~27 ~1 ~27 smooth_quartz"
        execute console command "execute at %player% run fill ~-22 ~2 ~-22 ~22 ~2 ~22 black_concrete"
        execute console command "execute at %player% run fill ~-18 ~3 ~-18 ~18 ~3 ~18 gold_block"
        execute console command "execute at %player% run fill ~-14 ~4 ~-14 ~14 ~4 ~14 polished_blackstone"
        execute console command "execute at %player% run fill ~-10 ~5 ~-10 ~10 ~5 ~10 quartz_block"
        execute console command "execute at %player% run fill ~-6 ~6 ~-6 ~6 ~6 ~6 gold_block"
        execute console command "execute at %player% run fill ~-2 ~7 ~-2 ~2 ~7 ~2 beacon"
        execute console command "execute at %player% run fill ~-35 ~0 ~-1 ~35 ~0 ~1 quartz_block"
        execute console command "execute at %player% run fill ~-1 ~0 ~-35 ~1 ~0 ~35 quartz_block"
        execute console command "execute at %player% run fill ~-2 ~1 ~-35 ~2 ~1 ~35 black_concrete"
        execute console command "execute at %player% run fill ~-35 ~1 ~-2 ~35 ~1 ~2 black_concrete"
        execute console command "execute at %player% run fill ~-35 ~2 ~-2 ~35 ~2 ~2 gold_block"
        execute console command "execute at %player% run fill ~-2 ~2 ~-35 ~2 ~2 ~35 gold_block"
        execute console command "execute at %player% run fill ~-35 ~3 ~-1 ~35 ~3 ~1 quartz_block"
        execute console command "execute at %player% run fill ~-1 ~3 ~-35 ~1 ~3 ~35 quartz_block"
        send "{@prefix} &aDonut-style spawn built."
        send "{@prefix} &7Spawn protection: &c100 blocks &7around this point."

on block break:
    if {az.donutspawn} is set:
        if distance between location of event-block and {az.donutspawn} <= 100:
            cancel event
            send "{@prefix} &cSpawn protected: you cannot break blocks here."
            stop

on block place:
    if {az.donutspawn} is set:
        if distance between location of event-block and {az.donutspawn} <= 100:
            cancel event
            send "{@prefix} &cSpawn protected: you cannot place blocks here."
            stop

on damage:
    if victim is a player:
        if {az.donutspawn} is set:
            if distance between location of victim and {az.donutspawn} <= 100:
                cancel event
                stop

on explode:
    if {az.donutspawn} is set:
        if distance between event-location and {az.donutspawn} <= 100:
            cancel event
