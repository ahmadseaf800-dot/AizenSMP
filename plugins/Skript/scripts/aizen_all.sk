on inventory click:
    if name of event-inventory is "&8✦ &6&lAIZEN SHOP &8✦":
        cancel event
        if clicked slot is 10:
            make player execute command "/endshop"
        else if clicked slot is 12:
            make player execute command "/netherShop"
        else if clicked slot is 14:
            make player execute command "/gearshop"
        else if clicked slot is 16:
            make player execute command "/foodshop"
        else if clicked slot is 22:
            make player execute command "/shardshop"
        else if clicked slot is 26:
            close player's inventory
        stop

