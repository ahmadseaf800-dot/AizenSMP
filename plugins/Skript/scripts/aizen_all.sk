            if {az.shards.%uuid of player%} < 2500:
                send "{@prefix} &cNot enough Shards."
                stop
            remove 2500 from {az.shards.%uuid of player%}
            give 1 tripwire hook named "&cCrimson Key" to player
            send "{@prefix} &aPurchased &cCrimson Key &afor &b2,500 Shards."
        else if clicked slot is 12:
            if {az.shards.%uuid of player%} < 2500:
                send "{@prefix} &cNot enough Shards."
                stop
            remove 2500 from {az.shards.%uuid of player%}