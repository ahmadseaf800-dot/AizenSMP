on inventory click:
    if name of event-inventory is "&8✦ &bSHARD SHOP &8✦":
        cancel event
        if clicked slot is 22:
            make player execute command "/shop"
            stop
        if clicked slot is 10:
            if {az.shards.%uuid of player%} < 2500:
                send "{@prefix} &cNot enough Shards."
                stop
            remove 2500 from {az.shards.%uuid of player%}
            give 1 tripwire hook named "&cCrimson Key" to player
            send "{@prefix} &aPurchased &cCrimson Key &afor &b2,500 Shards."
        else if clicked slot is 12:
            if {az.shards.%uuid of player%} < 2500:
                send "{@prefix} &cNot enough Shards."
                stop
            remove 2500 from {az.shards.%uuid of player%}
            give 1 tripwire hook named "&6Prime Key" to player
            send "{@prefix} &aPurchased &6Prime Key &afor &b2,500 Shards."
        else if clicked slot is 14:
            if {az.shards.%uuid of player%} < 1500:
                send "{@prefix} &cNot enough Shards."
                stop
            remove 1500 from {az.shards.%uuid of player%}
            give 1 spawner named "&5Spawner" to player
            send "{@prefix} &aPurchased &5Spawner &afor &b1,500 Shards."
        else if clicked slot is 16:
            if {az.shards.%uuid of player%} < 200:
                send "{@prefix} &cNot enough Shards."
                stop
            remove 200 from {az.shards.%uuid of player%}
            give 1 tripwire hook named "&fCommon Key" to player
            send "{@prefix} &aPurchased &fCommon Key &afor &b200 Shards."
        stop

# Legacy server fallback pricing command.
command /setsellprice <number>:
    permission: aizensmp.admin
    trigger:
        if player's tool is air:
            send "{@prefix} &cHold the item you want to price."
            stop
        if arg-1 < 0:
            send "{@prefix} &cPrice must be 0 or higher."
            stop
        set {az.sellprice.%type of player's tool%} to arg-1
        send "{@prefix} &aServer sell price set to &6$%arg-1% &aper item."

command /sellprice:
    trigger:
        if player's tool is air:
            send "{@prefix} &cHold an item."
            stop
        set {_unit} to {az.sellprice.%type of player's tool%}
        if {_unit} is not set:
            set {_unit} to 1
        send "{@prefix} &e%type of player's tool% &7server price: &6$%{_unit}% &7each."

# ---------------- DONUT-STYLE OLD SHOP ----------------

function azShopBuy(p: player, item: item, price: number, amount: number, label: text):
    if {az.money.%uuid of {_p}%} < {_price}:
        send "{@prefix} &cNot enough money. Price: &6$%{_price}%" to {_p}
        stop
    remove {_price} from {az.money.%uuid of {_p}%}
    give {_amount} of {_item} to {_p}
    send "{@prefix} &aBought &e%{_label}% &afor &6$%{_price}%&a." to {_p}

command /shop:
    aliases: /store
    trigger:
        open chest inventory with 3 rows named "&8✦ &6&lAIZEN SHOP &8✦" to player
        wait 1 tick
        set {_glass} to black stained glass pane named " "
        set slot 0 of player's current inventory to {_glass}
        set slot 1 of player's current inventory to {_glass}
        set slot 2 of player's current inventory to {_glass}
        set slot 3 of player's current inventory to {_glass}
        set slot 4 of player's current inventory to gold block named "&6&lAIZEN SHOP" with lore "&7Donut-style market", "&8Select a category"
        set slot 5 of player's current inventory to {_glass}
        set slot 6 of player's current inventory to {_glass}
        set slot 7 of player's current inventory to {_glass}
        set slot 8 of player's current inventory to {_glass}
        set slot 9 of player's current inventory to {_glass}
        set slot 10 of player's current inventory to ender chest named "&5&lEND SHOP" with lore "&7End resources", "&eClick to open"
        set slot 11 of player's current inventory to {_glass}
