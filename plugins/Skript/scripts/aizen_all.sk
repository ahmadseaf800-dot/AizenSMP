on inventory click:
    if name of event-inventory is "&8✦ &cNETHER SHOP &8✦":
        cancel event
        if clicked slot is 22:
            close player's inventory
            make player execute command "/shop"
            stop
        if clicked slot is 10:
            azShopBuy(player, ghast tear, 350, 1, "Ghast Tear")
        else if clicked slot is 11:
            azShopBuy(player, crying obsidian, 150, 1, "Crying Obsidian")
        else if clicked slot is 12:
