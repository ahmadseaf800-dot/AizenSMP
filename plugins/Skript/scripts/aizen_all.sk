# =========================================================
# AizenSMP - COMPLETE CUSTOM SYSTEM
# Purpur 1.21.11 / Skript
# No claims, no events system, no external gameplay plugins.
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r
    rtp-range: 10000
    bounty-start: 5
    bounty-base: 1000
    bounty-step: 1000
    duel-timeout: 60 seconds
    request-timeout: 60 seconds
    spawn-protection-radius: 500
    spawn-protection-height: 80

# ---------------- SPAWN / AFK / DUELS ZONES ----------------

# Admin setup commands:
# /setspawn = center of the protected spawn
# /setafk = center of the protected AFK zone
# /setduel = duel lobby/zone location
# /buildspawn = builds the spawn structure around the current location

command /buildzones:
    permission: aizensmp.admin
    trigger:
        if {az.spawn} is not set:
            set {az.spawn} to location of player
        if {az.afk} is not set:
            set {az.afk} to location of player
        if {az.duel} is not set:
            set {az.duel} to location of player
        send "{@prefix} &aSpawn, AFK and Duels locations are configured." to player
        send "&7Spawn: &f%{az.spawn}%" to player
        send "&7AFK: &f%{az.afk}%" to player
        send "&7Duels: &f%{az.duel}%" to player

# ---------------- CORE / SPAWN / AFK ----------------

command /setspawn:
    permission: aizensmp.admin
    trigger:
        set {az.spawn} to location of player
        set {az.afk} to location of player
        set {az.donutspawn} to location of player
        delete {az.spawn.built}
        delete {az.bots.ready}
        send "{@prefix} &aSpawn set. Use &e/builddonutspawn &ato build the hub here." to player

command /spawn:
    trigger:
        if {az.spawn} is not set:
            send "{@prefix} &cSpawn is not set." to player
            stop
        teleport player to {az.spawn}
        send "{@prefix} &aTeleported to spawn." to player

command /setafk:
    permission: aizensmp.admin
    trigger:
        set {az.afk} to location of player
        send "{@prefix} &aAFK area set." to player

command /afk:
    trigger:
        if {az.afk} is not set:
            send "{@prefix} &cAFK area is not set." to player
            stop
        teleport player to {az.afk}
        send "{@prefix} &aTeleported to AFK." to player

command /aizenadmin:
    permission: aizensmp.admin
    trigger:
        send "&8&m-----------------------------"
        send "&6&lAizenSMP ADMIN"
        send "&e/setspawn &7/setafk &7/setduel"
        send "&e/setrichsign &7/setshop"
        send "&e/setrtpbot &7/setduelbot"
        send "&e/give-shard <player> <amount>"
        send "&8&m-----------------------------"

on join:
    if {az.money.%uuid of player%} is not set:
        set {az.money.%uuid of player%} to 0
    if {az.shards.%uuid of player%} is not set:
        set {az.shards.%uuid of player%} to 0
    if {az.streak.%uuid of player%} is not set:
        set {az.streak.%uuid of player%} to 0
    if {az.bounty.%uuid of player%} is not set:
        set {az.bounty.%uuid of player%} to 0
    if {az.settings.chat.%uuid of player%} is not set:
        set {az.settings.chat.%uuid of player%} to true
    if {az.settings.sidebar.%uuid of player%} is not set:
        set {az.settings.sidebar.%uuid of player%} to true
    if {az.settings.tpa.%uuid of player%} is not set:
        set {az.settings.tpa.%uuid of player%} to "all"
    if {az.settings.tpahere.%uuid of player%} is not set:
        set {az.settings.tpahere.%uuid of player%} to "all"
    if {az.settings.pay.%uuid of player%} is not set:
        set {az.settings.pay.%uuid of player%} to "all"
    if {az.settings.duel.%uuid of player%} is not set:
        set {az.settings.duel.%uuid of player%} to "all"
    if {az.rank.%uuid of player%} is not set:
        set {az.rank.%uuid of player%} to "Default"
    set {az.name.%uuid of player%} to name of player

    # Spawn is configured by the admin with /builddonutspawn or /setspawn.
    # Do not create it at a random first-join location.
    if {az.afk} is not set:
        if {az.spawn} is set:
            set {az.afk} to {az.spawn}
    if {az.duel} is not set:
        if {az.spawn} is set:
            set {az.duel} to {az.spawn}
    if {az.region.asia.center} is not set:
        set {az.region.asia.center} to location of player
        set {az.region.asia.radius} to 10000
    if {az.region.europe.center} is not set:
        set {az.region.europe.center} to location of player
        set {az.region.europe.radius} to 10000
    if {az.region.africa.center} is not set:
        set {az.region.africa.center} to location of player
        set {az.region.africa.radius} to 10000
    if {az.region.northamerica.center} is not set:
        set {az.region.northamerica.center} to location of player
        set {az.region.northamerica.radius} to 10000
    if {az.region.southamerica.center} is not set:
        set {az.region.southamerica.center} to location of player
        set {az.region.southamerica.radius} to 10000
    if {az.region.oceania.center} is not set:
        set {az.region.oceania.center} to location of player
        set {az.region.oceania.radius} to 10000
    send "{@prefix} &fWelcome to &eAizenSMP&f!" to player

on first join:
    send "{@prefix} &6Welcome! &fUse &e/help &fto see the server systems." to player

# ---------------- SPAWN / AFK / DUEL PROTECTION ----------------
# Spawn has an inner protected core and an outer protected shell.
# The 1000x1000 spawn is protected to a 500-block radius, including a vertical range.
# Duel arena is the only exception inside the spawn protection zone.

function azInsideProtectedSpawn(l: location) :: boolean:
    if {az.spawn} is not set:
        return false
    if world of {_l} is not world of {az.spawn}:
        return false
    if distance between {_l} and {az.spawn} <= {@spawn-protection-radius}:
        return true
    return false

function azInsideDuel(l: location) :: boolean:
    if {az.duel.arena} is not set:
        return false
    if world of {_l} is not world of {az.duel.arena}:
        return false
    if distance between {_l} and {az.duel.arena} <= {@duel-radius}:
        return true
    return false

on block break:
    if azInsideProtectedSpawn(location of event-block) is true:
        if azInsideDuel(location of event-block) is false:
            cancel event
            send "{@prefix} &cهذه المنطقة محمية بالكامل." to player
            stop
    if {az.afk} is set:
        if distance between location of event-block and {az.afk} <= 15:
            cancel event
            send "{@prefix} &cAFK area is protected." to player

on block place:
    if azInsideProtectedSpawn(location of event-block) is true:
        if azInsideDuel(location of event-block) is false:
            cancel event
            send "{@prefix} &cهذه المنطقة محمية بالكامل." to player
            stop
    if {az.afk} is set:
        if distance between location of event-block and {az.afk} <= 15:
            cancel event
            send "{@prefix} &cAFK area is protected." to player

on damage:
    if victim is a player:
        if azInsideProtectedSpawn(location of victim) is true:
            if azInsideDuel(location of victim) is false:
                cancel event
                stop
        if {az.afk} is set:
            if distance between location of victim and {az.afk} <= 15:
                cancel event

on explode:
    if azInsideProtectedSpawn(event-location) is true:
        if azInsideDuel(event-location) is false:
            cancel event
            stop
    if {az.afk} is set:
        if distance between event-location and {az.afk} <= 15:
            cancel event

# Prevent explosions from breaking protected spawn even when an explosion event
# is not fully cancelled by another system.
on explosion prime:
    if azInsideProtectedSpawn(event-location) is true:
        if azInsideDuel(event-location) is false:
            cancel event

# ---------------- ECONOMY ----------------

command /balance:
    aliases: /bal, /money
    trigger:
        send "{@prefix} &fBalance: &6$%{az.money.%uuid of player%}%"

command /pay <player> <number>:
    trigger:
        if arg-1 is player:
            if player does not have permission "aizensmp.admin":
                send "{@prefix} &cYou cannot pay yourself."
                stop
            if arg-2 <= 0:
                send "{@prefix} &cAmount must be positive."
                stop
            add arg-2 to {az.money.%uuid of player%}
            send "{@prefix} &aAdded &6$%arg-2% &ato your own balance."
            stop
        if arg-2 <= 0:
            send "{@prefix} &cAmount must be positive."
            stop
        if {az.settings.pay.%uuid of arg-1%} is "none":
            send "{@prefix} &cThat player disabled payments."
            stop
        if {az.settings.pay.%uuid of arg-1%} is "friends":
            if {az.friend.%uuid of arg-1%.%uuid of player%} is not true:
                send "{@prefix} &cPayments are friends-only."
                stop
        if {az.money.%uuid of player%} < arg-2:
            send "{@prefix} &cNot enough money."
            stop
        remove arg-2 from {az.money.%uuid of player%}
        add arg-2 to {az.money.%uuid of arg-1%}
        send "{@prefix} &aPaid &6$%arg-2% &ato &e%arg-1%&a."
        send "{@prefix} &aReceived &6$%arg-2% &afrom &e%player%&a." to arg-1

command /setmoney <player> <number>:
    permission: aizensmp.admin
    trigger:
        set {az.money.%uuid of arg-1%} to arg-2
        send "{@prefix} &aMoney updated."

command /addmoney <player> <number>:
    permission: aizensmp.admin
    trigger:
        add arg-2 to {az.money.%uuid of arg-1%}
        send "{@prefix} &aMoney added."

command /richest:
    trigger:
        send "&8&m-----------------------------"
        send "&6&lRICHEST PLAYERS"
        set {_n} to 0
        loop {az.money::*}:
            if loop-index does not contain ".":
                if loop-value > 0:
                    add 1 to {_n}
                    if {_n} <= 10:
                        send "&e%{_n}%. &f%{az.name.%loop-index%}% &7- &6$%loop-value%"
        if {_n} is 0:
            send "&7No rich players yet."
        send "&8&m-----------------------------"

command /setrichsign:
    permission: aizensmp.admin
    trigger:
        set {az.richsign} to location of player
        send "{@prefix} &aRichest leaderboard sign location saved."

every 1 minute:
    if {az.richsign} is set:
        set line 1 of block at {az.richsign} to "&6&lAIZEN RICH"
        set line 2 of block at {az.richsign} to "&eUse /richest"
        set line 3 of block at {az.richsign} to "&7Top players"
        set line 4 of block at {az.richsign} to "&6AizenSMP"

# ---------------- RANDOM RTP / RTPQ ----------------

function azSafeRTP(p: player, worldName: text):
    set {_w} to world({_worldName})
    if {_w} is not set:
        send "{@prefix} &cالعالم غير موجود: &e%{_worldName}%" to {_p}
        stop
    set {_found} to false
    loop 100 times:
        if {_found} is false:
            set {_x} to random integer between -5000 and 5000
            set {_z} to random integer between -5000 and 5000
            # Search downward through normal Nether terrain instead of using
            # the world's highest block (which can be the Nether roof/bedrock).
            if {_worldName} is "world_nether":
                loop 90 times:
                    if {_found} is false:
                        set {_y} to 110 - loop-number
                        set {_loc} to location at {_x}, {_y}, {_z} in {_w}
                        set {_below} to location below {_loc}
                        if block at {_loc} is air:
                            if block above {_loc} is air:
                                if block at {_below} is not air:
                                    if block at {_below} is not bedrock:
                                        if block at {_below} is not lava:
                                            if block at {_below} is not water:
                                                set {_feet} to {_loc}
                                                teleport {_p} to {_feet}
                                                set {_found} to true
            else:
                set {_loc} to location at {_x}, 0, {_z} in {_w}
                set {_top} to highest block at {_loc}
                set {_feet} to location above {_top}
                if y-coordinate of {_feet} > 5:
                    if block at {_feet} is air:
                        if block above {_feet} is air:
                            if block at {_top} is not water:
                                if block at {_top} is not lava:
                                    if block at {_top} is not bedrock:
                                        teleport {_p} to {_feet}
                                        set {_found} to true
    if {_found} is true:
        send "{@prefix} &aتم نقلك عشوائياً إلى &e%{_worldName}% &7(&f%round(x-coordinate of {_p})%, %round(y-coordinate of {_p})%, %round(z-coordinate of {_p})%&7)." to {_p}
    else:
        send "{@prefix} &cلم يتم العثور على مكان آمن. حاول مرة ثانية." to {_p}

command /rtp:
    trigger:
        set {_rtpgui} to chest inventory with 3 rows named "&e&lRANDOM TELEPORT"
        set slot 11 of {_rtpgui} to grass block named "&aOverworld RTP" with lore "&7انقر للانتقال العشوائي في العالم العادي"
        set slot 13 of {_rtpgui} to netherrack named "&cNether RTP" with lore "&7انقر للانتقال العشوائي في النذر"
        set slot 15 of {_rtpgui} to end stone named "&eEnd RTP" with lore "&7انقر للانتقال العشوائي في الإند"
        set slot 22 of {_rtpgui} to barrier named "&cإغلاق"
        open {_rtpgui} to player

command /rtpq [<player>]:
    trigger:
        if arg-1 is set:
            set {_target} to arg-1
        else:
            set {_target} to none
            loop all players:
                if loop-player is not player:
                    set {_target} to loop-player
                    stop
        if {_target} is not set:
            send "{@prefix} &cلا يوجد لاعب آخر متصل." to player
            stop
        if {_target} is player:
            send "{@prefix} &cلا يمكنك اختيار نفسك." to player
            stop

        set {_x} to random integer between -5000 and 5000
        set {_z} to random integer between -5000 and 5000
        set {_w} to world of player
        set {_found} to false
        loop 60 times:
            if {_found} is false:
                set {_loc} to location at {_x}, 0, {_z} in {_w}
                set {_top} to highest block at {_loc}
                set {_feet} to location above {_top}
                if block at {_feet} is air:
                    if block above {_feet} is air:
                        if block at {_top} is not water:
                            if block at {_top} is not lava:
                                teleport player to {_feet}
                                teleport {_target} to {_feet}
                                set {_found} to true
                if {_found} is false:
                    set {_x} to random integer between -5000 and 5000
                    set {_z} to random integer between -5000 and 5000
        if {_found} is false:
            send "{@prefix} &cلم يتم العثور على مكان آمن للقتال." to player
            stop
        send "{@prefix} &c&lRTPQ &fتم نقلك أنت و &e%{_target}% &fإلى مكان عشوائي للقتال!" to player
        send "{@prefix} &c&lRTPQ &fتم نقلك مع &e%player% &fإلى مكان عشوائي للقتال!" to {_target}

on inventory click:
    if name of event-inventory is "&e&lRANDOM TELEPORT":
        cancel event
        if index of event-slot is 22:
            close player's inventory
            stop
        if index of event-slot is 11:
            close player's inventory
            send "{@prefix} &eجاري البحث عن مكان آمن..." to player
            azSafeRTP(player, "world")
        else if index of event-slot is 13:
            close player's inventory
            send "{@prefix} &eجاري البحث عن مكان آمن في النذر..." to player
            azSafeRTP(player, "world_nether")
        else if index of event-slot is 15:
            close player's inventory
            send "{@prefix} &eجاري البحث عن مكان آمن في الإند..." to player
            azSafeRTP(player, "world_the_end")
        stop

# ---------------- BOUNTY / KILL STREAK ----------------

on death of player:
    if attacker is a player:
        add 1 to {az.streak.%uuid of attacker%}
        set {_s} to {az.streak.%uuid of attacker%}
        if {_s} >= {@bounty-start}:
            set {_b} to {@bounty-base} + (({_s} - {@bounty-start}) * {@bounty-step})
            set {az.bounty.%uuid of attacker%} to {_b}
            send "{@prefix} &cBOUNTY &7Your bounty is now &6$%{_b}%&7." to attacker
            broadcast "{@prefix} &e%attacker% &7has a &6$%{_b}% &7bounty!"
    set {az.streak.%uuid of victim%} to 0
    set {az.bounty.%uuid of victim%} to 0

command /bounty:
    aliases: /mybounty
    trigger:
        send "{@prefix} &fBounty: &6$%{az.bounty.%uuid of player%}% &7| Streak: &c%{az.streak.%uuid of player%}%"

command /bountytop:
    trigger:
        send "&8&m-----------------------------"
        send "&c&lBOUNTY BOARD"
        loop {az.bounty::*}:
            if loop-value > 0:
                send "&c• &f%{az.name.%loop-index%}% &7- &6$%loop-value%"
        send "&8&m-----------------------------"

# ---------------- FRIENDS ----------------

command /friend <text> [<player>]:
    aliases: /friends
    trigger:
        if arg-1 is "add":
            if arg-2 is not set:
                send "{@prefix} &c/friend add <player>"
                stop
            if arg-2 is player:
                stop
            set {az.friend.%uuid of player%.%uuid of arg-2%} to true
            set {az.friend.%uuid of arg-2%.%uuid of player%} to true
            send "{@prefix} &aFriend added."
            send "{@prefix} &a%player% added you as a friend." to arg-2
        else if arg-1 is "remove":
            if arg-2 is not set:
                stop
            delete {az.friend.%uuid of player%.%uuid of arg-2%}
            delete {az.friend.%uuid of arg-2%.%uuid of player%}
            send "{@prefix} &cFriend removed."
        else if arg-1 is "list":
            send "&8&m-----------------------------"
            send "&b&lFRIENDS"
            set {_found} to false
            loop all players:
                if {az.friend.%uuid of player%.%uuid of loop-player%} is true:
                    send "&a• &f%loop-player%"
                    set {_found} to true
            if {_found} is false:
                send "&7No online friends."
            send "&8&m-----------------------------"
        else:
            send "{@prefix} &7/friend add <player>"
            send "{@prefix} &7/friend remove <player>"
            send "{@prefix} &7/friend list"

# ---------------- TPA ----------------

command /tpa <player>:
    trigger:
        if arg-1 is player:
            send "{@prefix} &cلا يمكنك إرسال TPA لنفسك."
            stop
        if {az.combat.%uuid of player%} is set:
            send "{@prefix} &cلا يمكنك إرسال TPA أثناء الـCombat."
            stop
        if {az.combat.%uuid of arg-1%} is set:
            send "{@prefix} &cلا يمكنك إرسال TPA للاعب داخل الـCombat."
            stop
        if {az.settings.tpa.%uuid of arg-1%} is "none":
            send "{@prefix} &cهذا اللاعب عطّل طلبات TPA."
            stop
        if {az.settings.tpa.%uuid of arg-1%} is "friends":
            if {az.friend.%uuid of arg-1%.%uuid of player%} is not true:
                send "{@prefix} &cطلبات TPA لهذا اللاعب للأصدقاء فقط."
                stop
        if {az.tpa.%uuid of arg-1%} is set or {az.tpahere.%uuid of arg-1%} is set:
            send "{@prefix} &cلديه طلب انتقال معلّق بالفعل."
            stop
        if {az.tpa.cooldown.%uuid of player%} is set:
            send "{@prefix} &cانتظر قليلاً قبل إرسال طلب TPA آخر."
            stop
        set {az.tpa.%uuid of arg-1%} to player
        set {az.tpa.created.%uuid of arg-1%} to now
        set {az.tpa.cooldown.%uuid of player%} to true
        send "{@prefix} &aتم إرسال طلب TPA إلى &e%arg-1%&a." to player
        send "{@prefix} &e%player% &fيريد الانتقال إليك. &a/tpaccept &7أو &c/tpdeny" to arg-1
        wait 5 seconds
        delete {az.tpa.cooldown.%uuid of player%}
        if {az.tpa.%uuid of arg-1%} is player:
            delete {az.tpa.%uuid of arg-1%}
            delete {az.tpa.created.%uuid of arg-1%}
            if arg-1 is online:
                send "{@prefix} &7انتهت مدة طلب TPA." to arg-1
            if player is online:
                send "{@prefix} &7انتهت مدة طلب TPA." to player

command /tpahere <player>:
    trigger:
        if arg-1 is player:
            send "{@prefix} &cلا يمكنك استخدام TPAHERE على نفسك."
            stop
        if {az.combat.%uuid of player%} is set:
            send "{@prefix} &cلا يمكنك إرسال TPAHERE أثناء الـCombat."
            stop
        if {az.combat.%uuid of arg-1%} is set:
            send "{@prefix} &cلا يمكنك إرسال TPAHERE للاعب داخل الـCombat."
            stop
        if {az.settings.tpahere.%uuid of arg-1%} is "none":
            send "{@prefix} &cهذا اللاعب عطّل طلبات TPAHERE."
            stop
        if {az.settings.tpahere.%uuid of arg-1%} is "friends":
            if {az.friend.%uuid of arg-1%.%uuid of player%} is not true:
                send "{@prefix} &cطلبات TPAHERE لهذا اللاعب للأصدقاء فقط."
                stop
        if {az.tpa.%uuid of arg-1%} is set or {az.tpahere.%uuid of arg-1%} is set:
            send "{@prefix} &cلديه طلب انتقال معلّق بالفعل."
            stop
        if {az.tpahere.cooldown.%uuid of player%} is set:
            send "{@prefix} &cانتظر قليلاً قبل إرسال طلب TPAHERE آخر."
            stop
        set {az.tpahere.%uuid of arg-1%} to player
        set {az.tpahere.created.%uuid of arg-1%} to now
        set {az.tpahere.cooldown.%uuid of player%} to true
        send "{@prefix} &aتم إرسال طلب TPAHERE إلى &e%arg-1%&a." to player
        send "{@prefix} &e%player% &fيريد نقلك إليه. &a/tpaccept &7أو &c/tpdeny" to arg-1
        wait 5 seconds
        delete {az.tpahere.cooldown.%uuid of player%}
        if {az.tpahere.%uuid of arg-1%} is player:
            delete {az.tpahere.%uuid of arg-1%}
            delete {az.tpahere.created.%uuid of arg-1%}
            if arg-1 is online:
                send "{@prefix} &7انتهت مدة طلب TPAHERE." to arg-1
            if player is online:
                send "{@prefix} &7انتهت مدة طلب TPAHERE." to player

command /tpaccept:
    trigger:
        if {az.tpa.%uuid of player%} is set:
            set {_p} to {az.tpa.%uuid of player%}
            delete {az.tpa.%uuid of player%}
            delete {az.tpa.created.%uuid of player%}
            if {_p} is not online:
                send "{@prefix} &cاللاعب أصبح أوفلاين."
                stop
            if {az.combat.%uuid of player%} is set or {az.combat.%uuid of {_p}%} is set:
                send "{@prefix} &cلا يمكن قبول TPA أثناء الـCombat."
                stop
            set {az.teleporting.%uuid of {_p}%} to true
            set {az.teleport.start.%uuid of {_p}%} to location of {_p}
            send "{@prefix} &eسيتم نقلك خلال 3 ثوانٍ. لا تتحرك ولا تدخل Combat." to {_p}
            send "{@prefix} &aجاري تنفيذ TPA..." to player
            wait 3 seconds
            if {_p} is online:
                if {az.teleporting.%uuid of {_p}%} is true:
                    if {az.combat.%uuid of player%} is not set and {az.combat.%uuid of {_p}%} is not set:
                        teleport {_p} to player
                        send "{@prefix} &aتم قبول TPA." to player
                        send "{@prefix} &aتم نقلك بنجاح." to {_p}
                    else:
                        send "{@prefix} &cتم إلغاء TPA بسبب الـCombat." to {_p}
            delete {az.teleporting.%uuid of {_p}%}
            delete {az.teleport.start.%uuid of {_p}%}
            stop
        if {az.tpahere.%uuid of player%} is set:
            set {_p} to {az.tpahere.%uuid of player%}
            delete {az.tpahere.%uuid of player%}
            delete {az.tpahere.created.%uuid of player%}
            if {_p} is not online:
                send "{@prefix} &cاللاعب أصبح أوفلاين."
                stop
            if {az.combat.%uuid of player%} is set or {az.combat.%uuid of {_p}%} is set:
                send "{@prefix} &cلا يمكن قبول TPAHERE أثناء الـCombat."
                stop
            set {az.teleporting.%uuid of player%} to true
            set {az.teleport.start.%uuid of player%} to location of player
            send "{@prefix} &eسيتم نقلك خلال 3 ثوانٍ. لا تتحرك ولا تدخل Combat."
            send "{@prefix} &aجاري تنفيذ TPAHERE..." to {_p}
            wait 3 seconds
            if player is online:
                if {az.teleporting.%uuid of player%} is true:
                    if {az.combat.%uuid of player%} is not set and {az.combat.%uuid of {_p}%} is not set:
                        teleport player to {_p}
                        send "{@prefix} &aتم قبول TPAHERE." to player
                        send "{@prefix} &aتم نقل اللاعب إليك." to {_p}
                    else:
                        send "{@prefix} &cتم إلغاء TPAHERE بسبب الـCombat."
            delete {az.teleporting.%uuid of player%}
            delete {az.teleport.start.%uuid of player%}
            stop
        send "{@prefix} &cلا يوجد طلب انتقال معلّق."

command /tpdeny:
    trigger:
        if {az.tpa.%uuid of player%} is set:
            set {_p} to {az.tpa.%uuid of player%}
            delete {az.tpa.%uuid of player%}
            delete {az.tpa.created.%uuid of player%}
            if {_p} is online:
                send "{@prefix} &cتم رفض طلب TPA." to player
                send "{@prefix} &cتم رفض طلب TPA الخاص بك." to {_p}
            stop
        if {az.tpahere.%uuid of player%} is set:
            set {_p} to {az.tpahere.%uuid of player%}
            delete {az.tpahere.%uuid of player%}
            delete {az.tpahere.created.%uuid of player%}
            if {_p} is online:
                send "{@prefix} &cتم رفض طلب TPAHERE." to player
                send "{@prefix} &cتم رفض طلب TPAHERE الخاص بك." to {_p}
            stop
        send "{@prefix} &cلا يوجد طلب انتقال معلّق."

on move:
    if {az.teleporting.%uuid of player%} is true:
        if {az.teleport.start.%uuid of player%} is set:
            if distance between location of player and {az.teleport.start.%uuid of player%} > 0.5:
                delete {az.teleporting.%uuid of player%}
                delete {az.teleport.start.%uuid of player%}
                send "{@prefix} &cتم إلغاء الانتقال لأنك تحركت." to player

on damage:
    if {az.teleporting.%uuid of victim%} is true:
        delete {az.teleporting.%uuid of victim%}
        delete {az.teleport.start.%uuid of victim%}
        send "{@prefix} &cتم إلغاء الانتقال لأنك تعرضت للضرر." to victim

# ---------------- SETTINGS ----------------

command /settings:
    trigger:
        open chest inventory with 3 rows named "&8✦ &bAizen Settings &8✦" to player
        wait 1 tick
        set slot 10 of player's current inventory to paper named "&eChat" with lore "&7%{az.settings.chat.%uuid of player%}%"
        set slot 12 of player's current inventory to ender pearl named "&bTPA" with lore "&7%{az.settings.tpa.%uuid of player%}%"
        set slot 14 of player's current inventory to ender pearl named "&bTPAHERE" with lore "&7%{az.settings.tpahere.%uuid of player%}%"
        set slot 16 of player's current inventory to gold ingot named "&6Payments" with lore "&7%{az.settings.pay.%uuid of player%}%"
        set slot 22 of player's current inventory to diamond sword named "&cDuels" with lore "&7%{az.settings.duel.%uuid of player%}%"
        set slot 24 of player's current inventory to map named "&bStatistics Sidebar" with lore "&7%{az.settings.sidebar.%uuid of player%}%"

on chat:
    if {az.settings.chat.%uuid of player%} is false:
        cancel event
        send "{@prefix} &cChat is disabled in your settings."

# ---------------- SETTINGS GUI ACTIONS ----------------

on inventory click:
    if name of event-inventory is "&8✦ &bAizen Settings &8✦":
        cancel event
        if clicked slot is 10:
            if {az.settings.chat.%uuid of player%} is true:
                set {az.settings.chat.%uuid of player%} to false
            else:
                set {az.settings.chat.%uuid of player%} to true
        else if clicked slot is 12:
            if {az.settings.tpa.%uuid of player%} is "all":
                set {az.settings.tpa.%uuid of player%} to "friends"
            else if {az.settings.tpa.%uuid of player%} is "friends":
                set {az.settings.tpa.%uuid of player%} to "none"
            else:
                set {az.settings.tpa.%uuid of player%} to "all"
        else if clicked slot is 14:
            if {az.settings.tpahere.%uuid of player%} is "all":
                set {az.settings.tpahere.%uuid of player%} to "friends"
            else if {az.settings.tpahere.%uuid of player%} is "friends":
                set {az.settings.tpahere.%uuid of player%} to "none"
            else:
                set {az.settings.tpahere.%uuid of player%} to "all"
        else if clicked slot is 16:
            if {az.settings.pay.%uuid of player%} is "all":
                set {az.settings.pay.%uuid of player%} to "friends"
            else if {az.settings.pay.%uuid of player%} is "friends":
                set {az.settings.pay.%uuid of player%} to "none"
            else:
                set {az.settings.pay.%uuid of player%} to "all"
        else if clicked slot is 22:
            if {az.settings.duel.%uuid of player%} is "all":
                set {az.settings.duel.%uuid of player%} to "friends"
            else if {az.settings.duel.%uuid of player%} is "friends":
                set {az.settings.duel.%uuid of player%} to "none"
            else:
                set {az.settings.duel.%uuid of player%} to "all"
        else if clicked slot is 24:
            if {az.settings.sidebar.%uuid of player%} is true:
                set {az.settings.sidebar.%uuid of player%} to false
                clear player's scoreboard
            else:
                set {az.settings.sidebar.%uuid of player%} to true
                azUpdateSidebar(player)
        close player's inventory
        send "{@prefix} &aSetting updated."

# ---------------- DUELS ----------------
# Player-vs-player combat is allowed only inside the duel arena.
# A duel has NO timer. Combat remains active until one player dies.
# The active duel is locked inside the arena: players cannot leave by walking.
# Breaking/placing blocks inside the arena is intentionally allowed.
# When the duel ends, the arena is restored to its saved state.

options:
    duel-radius: 25

command /duels:
    trigger:
        if {az.duel.arena} is not set:
            send "{@prefix} &cDuel arena is not set."
            stop
        if {az.combat.%uuid of player%} is set:
            send "{@prefix} &cلا يمكنك الانتقال أثناء الـCombat."
            stop
        teleport player to {az.duel.arena}
        send "{@prefix} &aTeleported to the Duel lobby."

function azDuelInside(p: player) :: boolean:
    if {az.duel.arena} is not set:
        return false
    if world of {_p} is not world of {az.duel.arena}:
        return false
    if distance between location of {_p} and {az.duel.arena} <= {@duel-radius}:
        return true
    return false

# Keep active duel players inside the arena.
# This does NOT protect blocks: players may mine/place normally inside.
on player move:
    if {az.duel.%uuid of player%} is set:
        if azDuelInside(player) is false:
            cancel event

function azDuelSaveArena():
    if {az.duel.arena} is not set:
        stop
    delete {az.duel.saved::*}
    set {_center} to {az.duel.arena}
    set {_n} to 0
    loop blocks within location at (x-coordinate of {_center} - {@duel-radius}), (y-coordinate of {_center} - 1), (z-coordinate of {_center} - {@duel-radius}) in world of {_center} and location at (x-coordinate of {_center} + {@duel-radius}), (y-coordinate of {_center} + 18), (z-coordinate of {_center} + {@duel-radius}) in world of {_center}:
        add 1 to {_n}
        set {az.duel.saved.%{_n}%.loc} to location of loop-block
        set {az.duel.saved.%{_n}%.type} to type of loop-block
    set {az.duel.saved.count} to {_n}

function azDuelRestoreArena():
    if {az.duel.saved.count} is not set:
        stop
    loop {az.duel.saved.count} times:
        set {_loc} to {az.duel.saved.%loop-number%.loc}
        set {_type} to {az.duel.saved.%loop-number%.type}
        if {_loc} is set:
            set block at {_loc} to {_type}
    delete {az.duel.saved::*}
    delete {az.duel.saved.count}

function azDuelEnd(p1: player, p2: player):
    if {_p1} is set:
        delete {az.duel.%uuid of {_p1}%}
        delete {az.duel.start.%uuid of {_p1}%}
        delete {az.combat.%uuid of {_p1}%}
        delete {az.combat.time.%uuid of {_p1}%}
    if {_p2} is set:
        delete {az.duel.%uuid of {_p2}%}
        delete {az.duel.start.%uuid of {_p2}%}
        delete {az.combat.%uuid of {_p2}%}
        delete {az.combat.time.%uuid of {_p2}%}
    if {_p1} is online:
        if {az.spawn} is set:
            teleport {_p1} to {az.spawn}
        send "{@prefix} &aانتهى الدويل." to {_p1}
    if {_p2} is online:
        if {az.spawn} is set:
            teleport {_p2} to {az.spawn}
        send "{@prefix} &aانتهى الدويل." to {_p2}
    delete {az.duel.active}
    azDuelRestoreArena()

command /duel [<player>]:
    trigger:
        set {_target} to arg-1
        if {_target} is not set:
            loop all players:
                if loop-player is not player:
                    if {az.duel.%uuid of loop-player%} is not set:
                        set {_target} to loop-player
                        stop
            if {_target} is not set:
                send "{@prefix} &cNo available opponent."
                stop
        if {_target} is player:
            stop
        if {az.duel.%uuid of player%} is set:
            send "{@prefix} &cYou are already dueling."
            stop
        if {az.duel.%uuid of {_target}%} is set:
            send "{@prefix} &cThat player is already dueling."
            stop
        if {az.combat.%uuid of player%} is set or {az.combat.%uuid of {_target}%} is set:
            send "{@prefix} &cلا يمكن بدء Duel أثناء الـCombat."
            stop
        if {az.settings.duel.%uuid of {_target}%} is "none":
            send "{@prefix} &cDuel requests disabled."
            stop
        if {az.settings.duel.%uuid of {_target}%} is "friends":
            if {az.friend.%uuid of {_target}%.%uuid of player%} is not true:
                send "{@prefix} &cDuel requests are friends-only."
                stop
        if {az.duel.arena} is not set:
            send "{@prefix} &cDuel arena is not set."
            stop
        set {az.duel.request.%uuid of {_target}%} to player
        send "{@prefix} &aDuel request sent."
        send "{@prefix} &e%player% &fwants to duel you: &a/duelaccept &7or &c/dueldeny" to {_target}
        wait {@duel-timeout}
        if {az.duel.request.%uuid of {_target}%} is player:
            delete {az.duel.request.%uuid of {_target}%}

command /duelaccept:
    trigger:
        if {az.duel.request.%uuid of player%} is not set:
            send "{@prefix} &cNo duel request."
            stop
        set {_p} to {az.duel.request.%uuid of player%}
        delete {az.duel.request.%uuid of player%}
        if {_p} is not online:
            send "{@prefix} &cThe player is offline."
            stop
        if {az.duel.active} is set:
            send "{@prefix} &cهناك Duel آخر جارٍ حالياً."
            stop
        if {az.combat.%uuid of player%} is set or {az.combat.%uuid of {_p}%} is set:
            send "{@prefix} &cلا يمكن بدء Duel أثناء الـCombat."
            stop

        azDuelSaveArena()
        set {az.duel.active} to true
        set {az.duel.%uuid of player%} to {_p}
        set {az.duel.%uuid of {_p}%} to player
        set {az.duel.start.%uuid of player%} to now
        set {az.duel.start.%uuid of {_p}%} to now

        teleport player to {az.duel.spawn1}
        teleport {_p} to {az.duel.spawn2}
        send "{@prefix} &aDuel started! &7No time limit — fight until one player dies." to player
        send "{@prefix} &aDuel started! &7No time limit — fight until one player dies." to {_p}

command /dueldeny:
    trigger:
        if {az.duel.request.%uuid of player%} is set:
            set {_p} to {az.duel.request.%uuid of player%}
            delete {az.duel.request.%uuid of player%}
            send "{@prefix} &cDuel denied." to player
            if {_p} is online:
                send "{@prefix} &cYour duel request was denied." to {_p}

# PvP is allowed only when two players are actively dueling and both are inside the arena.
on damage:
    if attacker is a player:
        if victim is a player:
            if {az.duel.%uuid of attacker%} is not victim:
                cancel event
                stop
            if azDuelInside(attacker) is false or azDuelInside(victim) is false:
                cancel event
                stop
            # Combat starts ONLY from a player hitting a player.
            set {az.combat.%uuid of attacker%} to true
            set {az.combat.%uuid of victim%} to true

# Mobs/environment never create Combat.
# Ender Pearls are usable in normal gameplay; during combat they are blocked.

# Teleports are immediate outside combat.
on teleport:
    if {az.combat.%uuid of player%} is set:
        cancel event
        send "{@prefix} &cلا يمكنك الانتقال وأنت في Combat." to player
        stop
# Keep Inventory is ALWAYS disabled.
on death:
    if victim is a player:
        execute console command "gamerule keepInventory false"
        delete {az.teleport.pending.%uuid of victim%}
        delete {az.teleport.destination.%uuid of victim%}
        delete {az.teleport.bypass.%uuid of victim%}
        if {az.duel.%uuid of victim%} is set:
            set {_opponent} to {az.duel.%uuid of victim%}
            delete {az.duel.%uuid of victim%}
            delete {az.combat.%uuid of victim%}
            if {_opponent} is online:
                delete {az.duel.%uuid of {_opponent}%}
                delete {az.combat.%uuid of {_opponent}%}
                if {az.spawn} is set:
                    set {az.teleport.bypass.%uuid of {_opponent}%} to true
                    teleport {_opponent} to {az.spawn}
                    delete {az.teleport.bypass.%uuid of {_opponent}%}
                send "{@prefix} &aDuel ended because your opponent died." to {_opponent}
            azDuelRestoreArena()
            delete {az.duel.active}

on quit:
    # If a player quits during a duel, end the duel and regenerate the arena.
    if {az.duel.%uuid of player%} is set:
        set {_opponent} to {az.duel.%uuid of player%}
        delete {az.duel.%uuid of player%}
        delete {az.combat.%uuid of player%}
        delete {az.combat.time.%uuid of player%}
        if {_opponent} is online:
            delete {az.duel.%uuid of {_opponent}%}
            delete {az.combat.%uuid of {_opponent}%}
            delete {az.combat.time.%uuid of {_opponent}%}
            if {az.spawn} is set:
                set {az.teleport.bypass.%uuid of {_opponent}%} to true
                teleport {_opponent} to {az.spawn}
                delete {az.teleport.bypass.%uuid of {_opponent}%}
            send "{@prefix} &cDuel ended because your opponent left." to {_opponent}
        azDuelRestoreArena()
        delete {az.duel.active}
    delete {az.teleport.pending.%uuid of player%}
    delete {az.teleport.destination.%uuid of player%}
    delete {az.teleport.bypass.%uuid of player%}

# Keep Inventory disabled at startup too.
on load:
    execute console command "gamerule keepInventory false"
    # Never leave a damaged/stale arena after a script/server reload.
    if {az.duel.active} is set:
        azDuelRestoreArena()
        delete {az.duel.active}
    loop all players:
        delete {az.duel.%uuid of loop-player%}
        delete {az.combat.%uuid of loop-player%}
        delete {az.combat.time.%uuid of loop-player%}

# ---------------- DUEL / COMBAT LOCK ----------------
# There is NO Combat timer. Combat ends only when the player dies or the duel ends.
# No transfer command can be used while Combat is active.
on command:
    if {az.combat.%uuid of player%} is set:
        if command is "spawn" or command is "home" or command is "homes" or command is "rtp" or command is "rtpq" or command is "tpa" or command is "tpahere" or command is "tpaccept" or command is "tpdeny" or command is "warp" or command is "warps" or command is "wild" or command is "wilderness" or command is "random" or command is "afk" or command is "duels":
            cancel event
            send "{@prefix} &cلا يمكنك استخدام أوامر النقل أثناء الـCombat." to player

# ---------------- SELL / AUCTION HOUSE ----------------
#
# Anti-dupe rules:
# - Sell basket owns the items while it is open; items are saved and cleared on close.
# - A listing is deleted atomically before the item is paid out.
# - Purchase/list/cancel operations use a per-listing lock.
# - Money is always checked against the AizenSMP economy variable.
# - Players cannot buy their own listings.

options:
    ah-max-price: 1000000000
    ah-max-listings: 45

function azParsePrice(s: text) :: number:
    set {_v} to lowercase {_s}
    replace all "," in {_v} with ""
    if {_v} ends with "k":
        replace all "k" in {_v} with ""
        return (converted {_v} to number) * 1000
    if {_v} ends with "m":
        replace all "m" in {_v} with ""
        return (converted {_v} to number) * 1000000
    if {_v} ends with "b":
        replace all "b" in {_v} with ""
        return (converted {_v} to number) * 1000000000
    return converted {_v} to number

function azAHMatches(i: item, q: text) :: boolean:
    set {_name} to lowercase "%type of {_i}%"
    set {_query} to lowercase {_q}
    if {_query} is "all":
        return true
    if {_name} contains {_query}:
        return true
    return false

function azAHCleanup(id: number):
    delete {az.ah.item.%{_id}%}
    delete {az.ah.price.%{_id}%}
    delete {az.ah.seller.%{_id}%}
    delete {az.ah.sellername.%{_id}%}
    delete {az.ah.lock.%{_id}%}

function azAHCountSeller(u: text) :: number:
    set {_n} to 0
    loop {az.ah.seller::*}:
        if "%loop-value%" is {_u}:
            add 1 to {_n}
    return {_n}

command /sell:
    trigger:
        open chest inventory with 6 rows named "&8✦ &6AH Sell Basket &8✦" to player
        wait 1 tick
        loop 45 times:
            set {_slot} to loop-number - 1
            if {az.sellbasket.%uuid of player%.%{_slot}%} is set:
                set slot {_slot} of player's current inventory to {az.sellbasket.%uuid of player%.%{_slot}%}
        set slot 45 of player's current inventory to barrier named "&cClose"
        set slot 46 of player's current inventory to emerald named "&aList for sale" with lore "&7After adding items, close the menu", "&7then use &e/ah sell <price>"
        set slot 49 of player's current inventory to paper named "&eHow to sell" with lore "&71. Put items in the basket", "&72. Close it", "&73. Use &e/ah sell 10k"
        set slot 50 of player's current inventory to barrier named "&cClose"

on inventory click:
    if name of event-inventory is "&8✦ &6AH Sell Basket &8✦":
        if clicked slot >= 45:
            cancel event
            if clicked slot is 46:
                close player's inventory
                send "{@prefix} &eUse &f/ah sell <price> &7after placing your items."
            else:
                close player's inventory
            stop
        # Only the first 45 slots are item storage.

on inventory close:
    if name of event-inventory is "&8✦ &6AH Sell Basket &8✦":
        loop 45 times:
            set {_slot} to loop-number - 1
            set {_it} to item in slot {_slot} of event-inventory
            if {_it} is air:
                delete {az.sellbasket.%uuid of player%.%{_slot}%}
            else:
                set {az.sellbasket.%uuid of player%.%{_slot}%} to {_it}
                set slot {_slot} of event-inventory to air

command /ah [<text>] [<text>]:
    aliases: /auctionhouse, /auction
    trigger:
        if arg-1 is "sell":
            if arg-2 is not set:
                send "{@prefix} &cUsage: /ah sell <price> &7(example: /ah sell 10m)"
                stop
            set {_price} to azParsePrice(arg-2)
            if {_price} <= 0:
                send "{@prefix} &cPrice must be positive."
                stop
            if {_price} > {@ah-max-price}:
                send "{@prefix} &cMaximum AH price is &6$1,000,000,000&c."
                stop
            if azAHCountSeller("%uuid of player%") >= {@ah-max-listings}:
                send "{@prefix} &cYou already have the maximum of &e45 &clistings."
                stop

            set {_item} to player's tool
            if {_item} is air:
                send "{@prefix} &cHold the item you want to sell in your hand."
                stop

            set {az.ah.next} to {az.ah.next} + 1
            set {_id} to {az.ah.next}
            set {az.ah.item.%{_id}%} to {_item}
            set {az.ah.price.%{_id}%} to {_price}
            set {az.ah.seller.%{_id}%} to uuid of player
            set {az.ah.sellername.%{_id}%} to name of player
            set player's tool to air

            send "{@prefix} &aListed &e%amount of {_item}% &f%name of {_item}% &afor &6$%{_price}%&a."
            stop

        if arg-1 is "my":
            azOpenAHMy(player)
            stop

        set {_query} to "all"
        if arg-1 is set:
            set {_query} to arg-1
        set {_sort} to "new"
        if arg-2 is set:
            set {_sort} to lowercase arg-2
        if {_sort} is not "new" and {_sort} is not "cheap" and {_sort} is not "expensive":
            set {_sort} to "new"
        azOpenAH(player, {_query}, {_sort})

function azOpenAH(p: player, q: text, sort: text):
    open chest inventory with 6 rows named "&8✦ &6Aizen Auction House &8✦" to {_p}
    wait 1 tick
    loop 54 times:
        set {_s} to loop-number - 1
        delete {az.ah.gui.%uuid of {_p}%.%{_s}%}
    set {_slot} to 0
    set {_count} to 0
    loop {az.ah.item::*}:
        if {_slot} >= 45:
            stop
        set {_id} to loop-index parsed as integer
        set {_item} to loop-value
        if {_item} is not air:
            if azAHMatches({_item}, {_q}) is true:
                set {_display} to {_item}
                set {_price} to {az.ah.price.%{_id}%}
                set lore of {_display} to "&7Seller: &f%{az.ah.sellername.%{_id}%}%", "&7Price: &6$%{_price}%", "&eClick to buy"
                set slot {_slot} of {_p}'s current inventory to {_display}
                set {az.ah.gui.%uuid of {_p}%.%{_slot}%} to {_id}
                add 1 to {_slot}
                add 1 to {_count}
    set slot 45 of {_p}'s current inventory to hopper named "&eCheapest" with lore "&7Use /ah all cheap"
    set slot 46 of {_p}'s current inventory to gold block named "&6Most Expensive" with lore "&7Use /ah all expensive"
    set slot 47 of {_p}'s current inventory to compass named "&bRefresh"
    set slot 48 of {_p}'s current inventory to paper named "&fSearch" with lore "&7Use /ah <item>"
    set slot 49 of {_p}'s current inventory to chest named "&aSell Basket" with lore "&7Open /sell"
    set slot 50 of {_p}'s current inventory to barrier named "&cClose"
    set slot 51 of {_p}'s current inventory to emerald named "&aMy Listings" with lore "&7Click to manage your listings"
    set slot 52 of {_p}'s current inventory to nether star named "&bAll Listings"
    set slot 53 of {_p}'s current inventory to paper named "&e%{_count}% Listings"
    set {az.ah.search.%uuid of {_p}%} to {_q}
    set {az.ah.sort.%uuid of {_p}%} to {_sort}

function azOpenAHMy(p: player):
    open chest inventory with 6 rows named "&8✦ &aMy AH Listings &8✦" to {_p}
    wait 1 tick
    loop 54 times:
        set {_s} to loop-number - 1
        delete {az.ah.my.%uuid of {_p}%.%{_s}%}
    set {_slot} to 0
    set {_count} to 0
    loop {az.ah.seller::*}:
        if {_slot} >= 45:
            stop
        set {_id} to loop-index parsed as integer
        if "%loop-value%" is "%uuid of {_p}%":
            if {az.ah.item.%{_id}%} is set:
                set {_display} to {az.ah.item.%{_id}%}
                set lore of {_display} to "&7Price: &6$%{az.ah.price.%{_id}%}%", "&cClick to cancel and return"
                set slot {_slot} of {_p}'s current inventory to {_display}
                set {az.ah.my.%uuid of {_p}%.%{_slot}%} to {_id}
                add 1 to {_slot}
                add 1 to {_count}
    set slot 45 of {_p}'s current inventory to arrow named "&cBack"
    set slot 53 of {_p}'s current inventory to paper named "&e%{_count}% Active Listings"

on inventory click:
    if name of event-inventory is "&8✦ &6Aizen Auction House &8✦":
        cancel event
        if clicked slot is 45:
            make player execute command "/ah all cheap"
            stop
        if clicked slot is 46:
            make player execute command "/ah all expensive"
            stop
        if clicked slot is 47:
            azOpenAH(player, {az.ah.search.%uuid of player%}, {az.ah.sort.%uuid of player%})
            stop
        if clicked slot is 48:
            send "{@prefix} &eUse &f/ah <item> &7for search."
            stop
        if clicked slot is 49:
            close player's inventory
            make player execute command "/sell"
            stop
        if clicked slot is 50:
            close player's inventory
            stop
        if clicked slot is 51:
            azOpenAHMy(player)
            stop
        if clicked slot is 52:
            azOpenAH(player, "all", {az.ah.sort.%uuid of player%})
            stop
        if clicked slot < 45:
            set {_id} to {az.ah.gui.%uuid of player%.%clicked slot%}
            if {_id} is not set:
                stop
            if {az.ah.lock.%{_id}%} is set:
                send "{@prefix} &cThis listing is being processed."
                stop
            if {az.ah.item.%{_id}%} is not set:
                send "{@prefix} &cThis listing is no longer available."
                stop
            set {_seller} to {az.ah.seller.%{_id}%}
            if "%{_seller}%" is "%uuid of player%":
                send "{@prefix} &cYou cannot buy your own listing."
                stop
            set {_price} to {az.ah.price.%{_id}%}
            if {_price} is not set or {_price} <= 0:
                send "{@prefix} &cInvalid listing."
                stop
            if {az.money.%uuid of player%} < {_price}:
                send "{@prefix} &cNot enough money. Need &6$%{_price}%&c."
                stop
            set {_azItem} to {az.ah.item.%{_id}%}
            if {_azItem} is not set or {_azItem} is air:
                send "{@prefix} &cThis listing is no longer available."
                stop

            set {az.ah.lock.%{_id}%} to true
            # Re-check everything after taking the lock.
            if {az.ah.item.%{_id}%} is not set:
                delete {az.ah.lock.%{_id}%}
                send "{@prefix} &cThis listing is no longer available."
                stop
            if {az.money.%uuid of player%} < {_price}:
                delete {az.ah.lock.%{_id}%}
                send "{@prefix} &cNot enough money."
                stop

            remove {_price} from {az.money.%uuid of player%}
            add {_price} to {az.money.%{_seller}%}
            delete {az.ah.item.%{_id}%}
            delete {az.ah.price.%{_id}%}
            delete {az.ah.seller.%{_id}%}
            delete {az.ah.sellername.%{_id}%}
            delete {az.ah.lock.%{_id}%}
            give {_azItem} to player
            send "{@prefix} &aPurchased &e%type of {_azItem}% &afor &6$%{_price}%&a."
            azOpenAH(player, {az.ah.search.%uuid of player%}, {az.ah.sort.%uuid of player%})
            stop

    if name of event-inventory is "&8✦ &aMy AH Listings &8✦":
        cancel event
        if clicked slot is 45:
            azOpenAH(player, "all", "new")
            stop
        if clicked slot < 45:
            set {_id} to {az.ah.my.%uuid of player%.%clicked slot%}
            if {_id} is not set:
                stop
            if {az.ah.lock.%{_id}%} is set:
                send "{@prefix} &cThis listing is being processed."
                stop
            if {az.ah.item.%{_id}%} is not set:
                send "{@prefix} &cListing already sold or removed."
                stop
            if "%{az.ah.seller.%{_id}%}%" is not "%uuid of player%":
                send "{@prefix} &cYou do not own this listing."
                stop
            set {az.ah.lock.%{_id}%} to true
            set {_returnItem} to {az.ah.item.%{_id}%}
            delete {az.ah.item.%{_id}%}
            delete {az.ah.price.%{_id}%}
            delete {az.ah.seller.%{_id}%}
            delete {az.ah.sellername.%{_id}%}
            delete {az.ah.lock.%{_id}%}
            give {_returnItem} to player
            send "{@prefix} &aListing cancelled and item returned."
            azOpenAHMy(player)
            stop

command /ahcancel <number>:
    trigger:
        set {_id} to arg-1
        if {az.ah.item.%{_id}%} is not set:
            send "{@prefix} &cListing not found."
            stop
        if "%{az.ah.seller.%{_id}%}%" is not "%uuid of player%":
            send "{@prefix} &cThat is not your listing."
            stop
        if {az.ah.lock.%{_id}%} is set:
            send "{@prefix} &cListing is busy."
            stop
        set {az.ah.lock.%{_id}%} to true
        set {_returnItem} to {az.ah.item.%{_id}%}
        delete {az.ah.item.%{_id}%}
        delete {az.ah.price.%{_id}%}
        delete {az.ah.seller.%{_id}%}
        delete {az.ah.sellername.%{_id}%}
        delete {az.ah.lock.%{_id}%}
        give {_returnItem} to player
        send "{@prefix} &aListing cancelled and item returned."

# Legacy server fallback pricing command.
command /setsellprice <number>:
    permission: aizensmp.admin
    trigger:
        if player's tool is air:
            send "{@prefix} &cHold the item you want to price."
            stop
        if arg-1 < 0:
            send "{@prefix} &cPrice must be 0 or higher."
            stop
        set {az.sellprice.%type of player's tool%} to arg-1
        send "{@prefix} &aServer sell price set to &6$%arg-1% &aper item."

command /sellprice:
    trigger:
        if player's tool is air:
            send "{@prefix} &cHold an item."
            stop
        set {_unit} to {az.sellprice.%type of player's tool%}
        if {_unit} is not set:
            set {_unit} to 1
        send "{@prefix} &e%type of player's tool% &7server price: &6$%{_unit}% &7each."
