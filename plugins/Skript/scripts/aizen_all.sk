        set slot 15 of player's current inventory to {_glass}
        set slot 16 of player's current inventory to cooked beef named "&6&lFOOD SHOP" with lore "&7Food & farming", "&eClick to open"
        set slot 17 of player's current inventory to {_glass}
        set slot 18 of player's current inventory to {_glass}
        set slot 19 of player's current inventory to {_glass}
        set slot 20 of player's current inventory to {_glass}
        set slot 21 of player's current inventory to {_glass}
        set slot 22 of player's current inventory to prismarine shard named "&b&lSHARD SHOP" with lore "&7Keys & special items", "&eClick to open"
        set slot 23 of player's current inventory to {_glass}
        set slot 24 of player's current inventory to {_glass}
