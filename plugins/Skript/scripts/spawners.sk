# =========================================================
# AizenSMP - Stacked Spawners
# Right-click a matching spawner with another one to stack.
# Break a stacked spawner to return the full stack to inventory.
# Each stack produces mobs once per minute per stored spawner.
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r
    max-stack: 64

function aizenSpawnerType(i: item) :: text:
    set {_n} to name of {_i}
    if {_n} contains "Zombie Spawner":
        return "Zombie"
    if {_n} contains "Skeleton Spawner":
        return "Skeleton"
    if {_n} contains "Blaze Spawner":
        return "Blaze"
    if {_n} contains "Enderman Spawner":
        return "Enderman"
    if {_n} contains "Iron Golem Spawner":
        return "Iron Golem"
    return ""

function aizenSpawnerItem(t: text, amount: number) :: item:
    if {_t} is "Zombie":
        return spawner named "&eZombie Spawner &7[%{_amount}%]"
    if {_t} is "Skeleton":
        return spawner named "&eSkeleton Spawner &7[%{_amount}%]"
    if {_t} is "Blaze":
        return spawner named "&eBlaze Spawner &7[%{_amount}%]"
    if {_t} is "Enderman":
        return spawner named "&eEnderman Spawner &7[%{_amount}%]"
    if {_t} is "Iron Golem":
        return spawner named "&eIron Golem Spawner &7[%{_amount}%]"

on right click on spawner:
    set {_held} to player's tool
    set {_type} to aizenSpawnerType({_held})
    if {_type} is "":
        stop
    set {_key} to "%world of event-block%:%x-coordinate of event-block%:%y-coordinate of event-block%:%z-coordinate of event-block%"
    if {aizensmp.spawner.%{_key}%.type} is not {_type}:
        stop
    cancel event
    set {_amount} to {aizensmp.spawner.%{_key}%.amount}
    if {_amount} is not set:
        set {_amount} to 1
    if {_amount} >= {@max-stack}:
        send "%{@prefix}% &cThis spawner is already at the maximum stack of &e{@max-stack}&c." to player
        stop
    remove 1 of player's tool from player
    add 1 to {_amount}
    set {aizensmp.spawner.%{_key}%.amount} to {_amount}
    set name of event-block to "&e%{_type}% Spawner &7[%{_amount}%]"
    send "%{@prefix}% &aSpawner stacked! &7Now: &e%{_amount}%&7." to player

on place of spawner:
    set {_type} to aizenSpawnerType(event-item)
    if {_type} is "":
        stop
    set {_key} to "%world of event-block%:%x-coordinate of event-block%:%y-coordinate of event-block%:%z-coordinate of event-block%"
    set {aizensmp.spawner.%{_key}%.type} to {_type}
    set {aizensmp.spawner.%{_key}%.amount} to 1
    set name of event-block to "&e%{_type}% Spawner &7[1]"

on break of spawner:
    set {_key} to "%world of event-block%:%x-coordinate of event-block%:%y-coordinate of event-block%:%z-coordinate of event-block%"
    set {_type} to {aizensmp.spawner.%{_key}%.type}
    if {_type} is not set:
        stop
    set {_amount} to {aizensmp.spawner.%{_key}%.amount}
    if {_amount} is not set:
        set {_amount} to 1
    cancel event
    set event-block to air
    give aizenSpawnerItem({_type}, {_amount}) to player
    delete {aizensmp.spawner.%{_key}%.type}
    delete {aizensmp.spawner.%{_key}%.amount}
    send "%{@prefix}% &aYou picked up &e%{_amount}% &a%{_type}% spawner(s)." to player

every 1 minute:
    loop all blocks:
        if loop-block is spawner:
            set {_key} to "%world of loop-block%:%x-coordinate of loop-block%:%y-coordinate of loop-block%:%z-coordinate of loop-block%"
            if {aizensmp.spawner.%{_key}%.type} is set:
                set {_type} to {aizensmp.spawner.%{_key}%.type}
                set {_amount} to {aizensmp.spawner.%{_key}%.amount}
                if {_amount} is not set:
                    set {_amount} to 1
                loop {_amount} times:
                    if {_type} is "Zombie":
                        spawn zombie at location of loop-block
                    else if {_type} is "Skeleton":
                        spawn skeleton at location of loop-block
                    else if {_type} is "Blaze":
                        spawn blaze at location of loop-block
                    else if {_type} is "Enderman":
                        spawn enderman at location of loop-block
                    else if {_type} is "Iron Golem":
                        spawn iron golem at location of loop-block
