# =========================================================
# AizenSMP - RTPQ
# /rtpq automatically finds one random online player and
# teleports both players to the same safe random location.
# No kit/items are added or removed.
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r
    rtp-range: 10000

command /rtpq:
    trigger:
        set {_target} to random player
        if {_target} is player:
            delete {_target}
        if {_target} is not set:
            loop all players:
                if loop-player is not player:
                    set {_target} to loop-player
                    stop
        if {_target} is not set:
            send "%{@prefix}% &cThere is no other online player available." to player
            stop

        set {_world} to world of player
        set {_found} to false

        loop 40 times:
            if {_found} is false:
                set {_x} to random integer between -{@rtp-range} and {@rtp-range}
                set {_z} to random integer between -{@rtp-range} and {@rtp-range}
                set {_base} to highest block at location at {_x}, 0, {_z} in {_world}
                set {_ground} to block below {_base}
                set {_feet} to {_base}
                set {_head} to block above {_base}

                if {_ground} is not water:
                    if {_ground} is not lava:
                        if {_ground} is not air:
                            if {_feet} is air:
                                if {_head} is air:
                                    if y-coordinate of {_base} > 5:
                                        teleport player to {_base}
                                        teleport {_target} to {_base}
                                        set {_found} to true
                                        send "%{@prefix}% &aYou were matched with &e%{_target}%&a and RTPQ'd together." to player
                                        send "%{@prefix}% &aYou were matched with &e%player%&a and RTPQ'd together." to {_target}

        if {_found} is false:
            send "%{@prefix}% &cCould not find a safe random location. Try again." to player
