# =========================================================
# AizenSMP - RTPQ
# /rtpq <player> teleports two players together.
# No kit/items are added or removed.
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r
    rtp-range: 10000

command /rtpq <player>:
    trigger:
        if arg-1 is player:
            send "%{@prefix}% &cYou cannot RTPQ with yourself." to player
            stop
        if arg-1 is not online:
            send "%{@prefix}% &cThat player is not online." to player
            stop

        if world of player is not world of arg-1:
            send "%{@prefix}% &cBoth players must be in the same world." to player
            stop

        set {_world} to world of player
        set {_found} to false

        loop 40 times:
            if {_found} is false:
                set {_x} to random integer between -{@rtp-range} and {@rtp-range}
                set {_z} to random integer between -{@rtp-range} and {@rtp-range}
                set {_base} to highest block at location at {_x}, 0, {_z} in {_world}
                set {_ground} to block below {_base}
                set {_feet} to {_base}
                set {_head} to block above {_base}

                if {_ground} is not water:
                    if {_ground} is not lava:
                        if {_ground} is not air:
                            if {_feet} is air:
                                if {_head} is air:
                                    if y-coordinate of {_base} > 5:
                                        teleport player to {_base}
                                        teleport arg-1 to {_base}
                                        set {_found} to true
                                        send "%{@prefix}% &aRTPQ complete. You were sent to the same random location." to player
                                        send "%{@prefix}% &aRTPQ complete. You were sent to the same random location." to arg-1

        if {_found} is false:
            send "%{@prefix}% &cCould not find a safe random location. Try again." to player
