# =========================================================
# AizenSMP - Automatic Kill-Streak Bounty
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r
    kills-for-bounty: 5
    base-bounty: 1000
    bounty-step: 1000

on join:
    if {aizensmp.killstreak.%uuid of player%} is not set:
        set {aizensmp.killstreak.%uuid of player%} to 0
    if {aizensmp.bounty.%uuid of player%} is not set:
        set {aizensmp.bounty.%uuid of player%} to 0
    set {aizensmp.bounty.name.%uuid of player%} to name of player

on death of player:
    if attacker is a player:
        set {_killer} to attacker
        add 1 to {aizensmp.killstreak.%uuid of {_killer}%}
        set {_streak} to {aizensmp.killstreak.%uuid of {_killer}%}
        if {_streak} >= {@kills-for-bounty}:
            set {_steps} to {_streak} - {@kills-for-bounty} + 1
            set {_newbounty} to {@base-bounty} + (({_steps} - 1) * {@bounty-step})
            if {_newbounty} > {aizensmp.bounty.%uuid of {_killer}%}:
                set {aizensmp.bounty.%uuid of {_killer}%} to {_newbounty}
                send "%{@prefix}% &c&lBOUNTY &7Your bounty is now &6$%{_newbounty}%&7!" to {_killer}
                broadcast "%{@prefix}% &e%{_killer}% &7has reached a &6$%{_newbounty}% &7bounty!"
        set {_killerName} to name of {_killer}
        set {aizensmp.bounty.name.%uuid of {_killer}%} to {_killerName}
    set {aizensmp.killstreak.%uuid of victim%} to 0
    set {aizensmp.bounty.%uuid of victim%} to 0
    delete {aizensmp.bounty.name.%uuid of victim%}

command /bounty:
    trigger:
        send "%{@prefix}% &fYour bounty: &6$%{aizensmp.bounty.%uuid of player%}% &7| Kill streak: &c%{aizensmp.killstreak.%uuid of player%}%"

command /bountytop:
    aliases: /bountyleaderboard
    trigger:
        send "&8&m------------------------------"
        send "&c&lBOUNTY LEADERBOARD"
        send "&7Only players with an active bounty are shown."
        set {_count} to 0
        loop {aizensmp.bounty::*}:
            if loop-index does not contain ".name.":
                if loop-value > 0:
                    add 1 to {_count}
                    if {_count} <= 10:
                        set {_uuid} to loop-index
                        send "&e%{_count}%. &f%{aizensmp.bounty.name.%{_uuid}%}% &7- &6$%loop-value%"
        send "&8&m------------------------------"
