# AIZEN SMP - DONUT STYLE SPAWN
options:
    prefix: &6[&eAizenSMP&6] &r

function azBuildDonutSpawn(p: player):
    set {az.spawn} to location of {_p}
    set {az.afk} to location of {_p}
    set {az.duel} to location of {_p}
    delete {az.spawn.built}
    delete {az.bots.ready}

    execute console command "execute at %{_p}% run fill ~-60 ~-3 ~-60 ~60 ~25 ~60 air"
    execute console command "execute at %{_p}% run fill ~-60 ~-2 ~-60 ~60 ~-2 ~60 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-56 ~-1 ~-56 ~56 ~-1 ~56 blackstone"
    execute console command "execute at %{_p}% run fill ~-52 ~0 ~-52 ~52 ~0 ~52 smooth_quartz"

    # Radial roads.
    execute console command "execute at %{_p}% run fill ~-56 ~0 ~-5 ~56 ~0 ~5 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-5 ~0 ~-56 ~5 ~0 ~56 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-5 ~1 ~-56 ~5 ~1 ~56 gold_block"
    execute console command "execute at %{_p}% run fill ~-56 ~1 ~-5 ~56 ~1 ~5 gold_block"
    execute console command "execute at %{_p}% run fill ~-45 ~0 ~-48 ~-40 ~0 ~-43 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~40 ~0 ~-48 ~45 ~0 ~-43 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-45 ~0 ~43 ~-40 ~0 ~48 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~40 ~0 ~43 ~45 ~0 ~48 polished_blackstone"

    # Central plaza.
    execute console command "execute at %{_p}% run fill ~-20 ~1 ~-20 ~20 ~1 ~20 black_concrete"
    execute console command "execute at %{_p}% run fill ~-18 ~2 ~-18 ~18 ~2 ~18 quartz_block"
    execute console command "execute at %{_p}% run fill ~-15 ~3 ~-15 ~15 ~3 ~15 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-11 ~4 ~-11 ~11 ~4 ~11 smooth_quartz"
    execute console command "execute at %{_p}% run fill ~-7 ~5 ~-7 ~7 ~5 ~7 gold_block"
    execute console command "execute at %{_p}% run fill ~-3 ~6 ~-3 ~3 ~6 ~3 beacon"
    execute console command "execute at %{_p}% run fill ~-5 ~7 ~-5 ~5 ~13 ~5 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-3 ~14 ~-3 ~3 ~17 ~3 gold_block"
    execute console command "execute at %{_p}% run setblock ~0 ~18 ~0 beacon"

    # Four service platforms.
    execute console command "execute at %{_p}% run fill ~-28 ~2 ~-12 ~-18 ~4 ~-2 blackstone"
    execute console command "execute at %{_p}% run fill ~18 ~2 ~-12 ~28 ~4 ~-2 blackstone"
    execute console command "execute at %{_p}% run fill ~-28 ~2 ~2 ~-18 ~4 ~12 blackstone"
    execute console command "execute at %{_p}% run fill ~18 ~2 ~2 ~28 ~4 ~12 blackstone"

    # Enclosed perimeter and four entrances.
    execute console command "execute at %{_p}% run fill ~-60 ~0 ~-60 ~60 ~10 ~-60 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-60 ~0 ~60 ~60 ~10 ~60 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-60 ~0 ~-60 ~-60 ~10 ~60 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~60 ~0 ~-60 ~60 ~10 ~60 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-5 ~0 ~-61 ~5 ~6 ~-59 air"
    execute console command "execute at %{_p}% run fill ~-5 ~0 ~59 ~5 ~6 ~61 air"
    execute console command "execute at %{_p}% run fill ~-61 ~0 ~-5 ~-59 ~6 ~5 air"
    execute console command "execute at %{_p}% run fill ~59 ~0 ~-5 ~61 ~6 ~5 air"
    execute console command "execute at %{_p}% run fill ~-7 ~0 ~-62 ~7 ~7 ~-62 gold_block outline"
    execute console command "execute at %{_p}% run fill ~-7 ~0 ~62 ~7 ~7 ~62 gold_block outline"
    execute console command "execute at %{_p}% run fill ~62 ~0 ~-7 ~62 ~7 ~7 gold_block outline"
    execute console command "execute at %{_p}% run fill ~-62 ~0 ~-7 ~-62 ~7 ~7 gold_block outline"

    # Outer towers.
    execute console command "execute at %{_p}% run fill ~-48 ~0 ~-48 ~-38 ~18 ~-38 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~38 ~0 ~-48 ~48 ~18 ~-38 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-48 ~0 ~38 ~-38 ~18 ~48 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~38 ~0 ~38 ~48 ~18 ~48 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-50 ~19 ~-50 ~-36 ~20 ~-36 gold_block"
    execute console command "execute at %{_p}% run fill ~36 ~19 ~-50 ~50 ~20 ~-36 gold_block"
    execute console command "execute at %{_p}% run fill ~-50 ~19 ~36 ~-36 ~20 ~50 gold_block"
    execute console command "execute at %{_p}% run fill ~36 ~19 ~36 ~50 ~20 ~50 gold_block"

    # Entrance arches and lighting.
    execute console command "execute at %{_p}% run fill ~-8 ~0 ~-54 ~-2 ~12 ~-48 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~2 ~0 ~-54 ~8 ~12 ~-48 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-8 ~0 ~48 ~-2 ~12 ~54 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~2 ~0 ~48 ~8 ~12 ~54 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-54 ~0 ~-8 ~-48 ~12 ~-2 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~48 ~0 ~-8 ~54 ~12 ~-2 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-54 ~0 ~2 ~-48 ~12 ~8 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~48 ~0 ~2 ~54 ~12 ~8 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-20 ~3 ~-20 ~20 ~3 ~20 gold_block outline"
    execute console command "execute at %{_p}% run fill ~-19 ~4 ~-19 ~19 ~4 ~19 sea_lantern outline"

    # AIZEN crown.
    execute console command "execute at %{_p}% run fill ~-10 ~4 ~28 ~10 ~4 ~28 gold_block"
    execute console command "execute at %{_p}% run fill ~-7 ~5 ~28 ~7 ~9 ~28 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-4 ~10 ~28 ~4 ~12 ~28 gold_block"

    set {az.spawn.built} to true
    send "{@prefix}&aتم بناء Spawn AIZEN الجديد." to {_p}
    send "{@prefix}&7المساحة: &f121x121 &7مع 4 مداخل." to {_p}

command /builddonutspawn:
    permission: aizensmp.admin
    aliases: /buildlegendaryspawn
    trigger:
        azBuildDonutSpawn(player)

on join:
    if {az.spawn} is not set:
        set {az.spawn} to location of player
        set {az.afk} to location of player
        set {az.duel} to location of player
    if {az.spawn.built} is not true:
        wait 2 seconds
        if player is online:
            azBuildDonutSpawn(player)
