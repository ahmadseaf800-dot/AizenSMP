# =========================================================
# AizenSMP - Spawn & Duel Arena Protection
# Spawn: no PvP, no building/breaking, no explosions
# Duel arena: no building/breaking/explosions, PvP allowed
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r
    spawn-radius: 25
    duel-radius: 30

command /setspawn:
    permission: aizensmp.admin
    permission message: &cYou don't have permission.
    trigger:
        set {aizensmp.spawn.location} to location of player
        send "%{@prefix}% &aSpawn location set." to player

on block break:
    if {aizensmp.spawn.location} is set:
        if distance between location of event-block and {aizensmp.spawn.location} <= {@spawn-radius}:
            cancel event
            send "%{@prefix}% &cSpawn is protected." to player
            stop
    if {aizensmp.duel.arena} is set:
        if distance between location of event-block and {aizensmp.duel.arena} <= {@duel-radius}:
            cancel event
            send "%{@prefix}% &cThe duel arena is protected." to player
            stop

on block place:
    if {aizensmp.spawn.location} is set:
        if distance between location of event-block and {aizensmp.spawn.location} <= {@spawn-radius}:
            cancel event
            send "%{@prefix}% &cSpawn is protected." to player
            stop
    if {aizensmp.duel.arena} is set:
        if distance between location of event-block and {aizensmp.duel.arena} <= {@duel-radius}:
            cancel event
            send "%{@prefix}% &cThe duel arena is protected." to player
            stop

on damage:
    if victim is a player:
        if {aizensmp.spawn.location} is set:
            if distance between location of victim and {aizensmp.spawn.location} <= {@spawn-radius}:
                cancel event
                stop
        if attacker is a player:
            if {aizensmp.duel.%uuid of victim%} is set:
                if {aizensmp.duel.%uuid of victim%} is attacker:
                    stop
            if {aizensmp.duel.arena} is set:
                if distance between location of victim and {aizensmp.duel.arena} <= {@duel-radius}:
                    if distance between location of attacker and {aizensmp.duel.arena} <= {@duel-radius}:
                        stop
            # Normal PvP remains enabled outside protected spawn.

on explode:
    if event-location is set:
        if {aizensmp.spawn.location} is set:
            if distance between event-location and {aizensmp.spawn.location} <= {@spawn-radius}:
                cancel event
                stop
        if {aizensmp.duel.arena} is set:
            if distance between event-location and {aizensmp.duel.arena} <= {@duel-radius}:
                cancel event
                stop

on damage of player:
    if attacker is a projectile:
        if shooter of attacker is a player:
            if {aizensmp.spawn.location} is set:
                if distance between location of victim and {aizensmp.spawn.location} <= {@spawn-radius}:
                    cancel event
                    stop
