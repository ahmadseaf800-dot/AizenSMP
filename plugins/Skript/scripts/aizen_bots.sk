# =========================================================
# AIZEN SMP - SPAWN COMMAND BOTS
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r

function azBotSpawn(label: text, loc: location):
    spawn an armor stand at {_loc}
    set name of last spawned entity to {_label}
    set invulnerability of last spawned entity to true
    set gravity of last spawned entity to false
    set visible of last spawned entity to true
    set marker state of last spawned entity to false
    set small state of last spawned entity to false
    set arms of last spawned entity to true
    set base plate of last spawned entity to false
    set helmet of last spawned entity to gold helmet
    set chestplate of last spawned entity to black leather chestplate
    set leggings of last spawned entity to black leather leggings
    set boots of last spawned entity to gold boots
    set item in main hand of last spawned entity to compass

function azRemoveOldBots():
    if {az.spawn} is not set:
        stop
    loop all entities in radius 65 around {az.spawn}:
        if loop-entity is an armor stand:
            if name of loop-entity is set:
                if name of loop-entity contains "AIZEN BOT":
                    kill loop-entity

function azSetupBots():
    if {az.spawn} is not set:
        stop
    if {az.bots.building} is true:
        stop
    set {az.bots.building} to true
    delete {az.bots.ready}
    azRemoveOldBots()
    set {_s} to {az.spawn}

    # Front command row.
    set {_l} to {_s}
    add -18 to x-coordinate of {_l}
    add 3 to y-coordinate of {_l}
    add -8 to z-coordinate of {_l}
    azBotSpawn("&6&lAIZEN BOT &b&lRTP", {_l})

    set {_l} to {_s}
    add 18 to x-coordinate of {_l}
    add 3 to y-coordinate of {_l}
    add -8 to z-coordinate of {_l}
    azBotSpawn("&6&lAIZEN BOT &e&lSHOP", {_l})

    set {_l} to {_s}
    add -18 to x-coordinate of {_l}
    add 3 to y-coordinate of {_l}
    add 8 to z-coordinate of {_l}
    azBotSpawn("&6&lAIZEN BOT &d&lTPA", {_l})

    set {_l} to {_s}
    add 18 to x-coordinate of {_l}
    add 3 to y-coordinate of {_l}
    add 8 to z-coordinate of {_l}
    azBotSpawn("&6&lAIZEN BOT &a&lAH", {_l})

    # Utility row.
    set {_l} to {_s}
    add -30 to x-coordinate of {_l}
    add 3 to y-coordinate of {_l}
    azBotSpawn("&6&lAIZEN BOT &c&lDUELS", {_l})

    set {_l} to {_s}
    add 30 to x-coordinate of {_l}
    add 3 to y-coordinate of {_l}
    azBotSpawn("&6&lAIZEN BOT &e&lKITS", {_l})

    set {_l} to {_s}
    add -30 to x-coordinate of {_l}
    add 3 to y-coordinate of {_l}
    add 10 to z-coordinate of {_l}
    azBotSpawn("&6&lAIZEN BOT &f&lRULES", {_l})

    set {_l} to {_s}
    add 30 to x-coordinate of {_l}
    add 3 to y-coordinate of {_l}
    add 10 to z-coordinate of {_l}
    azBotSpawn("&6&lAIZEN BOT &5&lSELL", {_l})

    # Rear utility row.
    set {_l} to {_s}
    add -18 to x-coordinate of {_l}
    add 3 to y-coordinate of {_l}
    add 25 to z-coordinate of {_l}
    azBotSpawn("&6&lAIZEN BOT &6&lSPAWN", {_l})

    set {_l} to {_s}
    add 18 to x-coordinate of {_l}
    add 3 to y-coordinate of {_l}
    add 25 to z-coordinate of {_l}
    azBotSpawn("&6&lAIZEN BOT &b&lRTPQ", {_l})

    set {_l} to {_s}
    add -8 to x-coordinate of {_l}
    add 3 to y-coordinate of {_l}
    add 34 to z-coordinate of {_l}
    azBotSpawn("&6&lAIZEN BOT &9&lINFO", {_l})

    set {_l} to {_s}
    add 8 to x-coordinate of {_l}
    add 3 to y-coordinate of {_l}
    add 34 to z-coordinate of {_l}
    azBotSpawn("&6&lAIZEN BOT &c&lDUEL ARENA", {_l})

    set {az.bots.ready} to true
    delete {az.bots.building}

on join:
    if {az.spawn} is set:
        wait 3 seconds
        if player is online:
            if {az.bots.ready} is not true:
                azSetupBots()

command /setupbots:
    permission: aizensmp.admin
    aliases: /buildbots
    trigger:
        azSetupBots()
        send "{@prefix}&aتم تجهيز كل Command Bots للـSpawn الجديد."

on right click on armor stand:
    set {_n} to name of clicked entity
    if {_n} does not contain "AIZEN BOT":
        stop
    cancel event

    if {_n} contains "RTP":
        make player execute command "/rtp"
        stop
    if {_n} contains "SHOP":
        make player execute command "/shop"
        stop
    if {_n} contains "TPA":
        set {az.bot.tpa.await.%uuid of player%} to true
        send "&6[&eAizenSMP&6] &eاكتب اسم اللاعب في الشات أو cancel."
        stop
    if {_n} contains "AH":
        make player execute command "/ah"
        stop
    if {_n} contains "DUELS":
        make player execute command "/duels"
        stop
    if {_n} contains "KITS":
        make player execute command "/kit"
        stop
    if {_n} contains "RULES":
        make player execute command "/rules"
        stop
    if {_n} contains "SPAWN":
        make player execute command "/spawn"
        stop
    if {_n} contains "SELL":
        make player execute command "/sell"
        stop
    if {_n} contains "RTPQ":
        make player execute command "/rtpq"
        stop
    if {_n} contains "INFO":
        send "&6&lAIZEN SMP &8• &fSurvival / Crystal PvP / Economy" to player
        send "&7/shop &8• &7/duel <player> &8• &7/rtp &8• &7/rtpq &8• &7/ah" to player
        stop
    if {_n} contains "DUEL ARENA":
        make player execute command "/duels"
        stop

on chat:
    if {az.bot.tpa.await.%uuid of player%} is not true:
        stop
    cancel event
    delete {az.bot.tpa.await.%uuid of player%}
    if lowercase(message) is "cancel":
        send "&6[&eAizenSMP&6] &cتم إلغاء طلب TPA."
        stop
    set {_target} to none
    loop all players:
        if lowercase(name of loop-player) is lowercase(message):
            set {_target} to loop-player
            stop
    if {_target} is not set:
        send "&6[&eAizenSMP&6] &cاللاعب غير موجود."
        stop
    if {_target} is player:
        send "&6[&eAizenSMP&6] &cلا يمكنك إرسال TPA لنفسك."
        stop
    make player execute command "/tpa %{_target}%"

on quit:
    delete {az.bot.tpa.await.%uuid of player%}
