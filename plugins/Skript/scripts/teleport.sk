# =========================================================
# AizenSMP - TPA System
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r
    request-time: 60 seconds

command /tpa <player>:
    trigger:
        if arg-1 is player:
            send "%{@prefix}% &cYou cannot send a teleport request to yourself." to player
            stop
        if arg-1 is not online:
            send "%{@prefix}% &cThat player is not online." to player
            stop
        if {aizensmp.settings.tpa.%uuid of arg-1%} is false:
            send "%{@prefix}% &cThat player has disabled TPA requests." to player
            stop
        set {aizensmp.tpa.%uuid of arg-1%} to player
        send "%{@prefix}% &aTeleport request sent to &e%arg-1%&a." to player
        send "%{@prefix}% &e%player% &f wants to teleport to you." to arg-1
        send "&a/tpaccept &7to accept &8| &c/tpdeny &7to deny" to arg-1
        wait {@request-time}
        if {aizensmp.tpa.%uuid of arg-1%} is player:
            delete {aizensmp.tpa.%uuid of arg-1%}

command /tpahere <player>:
    trigger:
        if arg-1 is player:
            send "%{@prefix}% &cYou cannot send a request to yourself." to player
            stop
        if arg-1 is not online:
            send "%{@prefix}% &cThat player is not online." to player
            stop
        if {aizensmp.settings.tpahere.%uuid of arg-1%} is false:
            send "%{@prefix}% &cThat player has disabled TPAHERE requests." to player
            stop
        set {aizensmp.tpahere.%uuid of arg-1%} to player
        send "%{@prefix}% &aTeleport-here request sent to &e%arg-1%&a." to player
        send "%{@prefix}% &e%player% &f wants you to teleport to them." to arg-1
        send "&a/tpaccept &7to accept &8| &c/tpdeny &7to deny" to arg-1
        wait {@request-time}
        if {aizensmp.tpahere.%uuid of arg-1%} is player:
            delete {aizensmp.tpahere.%uuid of arg-1%}

command /tpaccept:
    trigger:
        if {aizensmp.tpa.%uuid of player%} is set:
            set {_sender} to {aizensmp.tpa.%uuid of player%}
            if {_sender} is online:
                teleport {_sender} to player
                send "%{@prefix}% &aTeleport request accepted." to player
                send "%{@prefix}% &aYour teleport request was accepted." to {_sender}
            delete {aizensmp.tpa.%uuid of player%}
            stop

        if {aizensmp.tpahere.%uuid of player%} is set:
            set {_sender} to {aizensmp.tpahere.%uuid of player%}
            if {_sender} is online:
                teleport player to {_sender}
                send "%{@prefix}% &aTeleport-here request accepted." to player
                send "%{@prefix}% &aYour teleport-here request was accepted." to {_sender}
            delete {aizensmp.tpahere.%uuid of player%}
            stop

        send "%{@prefix}% &cYou have no pending teleport request." to player

command /tpdeny:
    trigger:
        if {aizensmp.tpa.%uuid of player%} is set:
            set {_sender} to {aizensmp.tpa.%uuid of player%}
            if {_sender} is online:
                send "%{@prefix}% &cYour teleport request was denied." to {_sender}
            delete {aizensmp.tpa.%uuid of player%}
            send "%{@prefix}% &cTeleport request denied." to player
            stop

        if {aizensmp.tpahere.%uuid of player%} is set:
            set {_sender} to {aizensmp.tpahere.%uuid of player%}
            if {_sender} is online:
                send "%{@prefix}% &cYour teleport-here request was denied." to {_sender}
            delete {aizensmp.tpahere.%uuid of player%}
            send "%{@prefix}% &cTeleport-here request denied." to player
            stop

        send "%{@prefix}% &cYou have no pending teleport request." to player
