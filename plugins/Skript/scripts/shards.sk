# =========================================================
# AizenSMP - Shards System
# Kill Reward: 10 Shards
# AFK Reward: 1 Shard / minute
# /shard shop = Spawners only
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r
    shard-symbol: &b✦

command /shard [<text>] [<number>]:
    trigger:
        if arg-1 is not set:
            if {aizensmp.shards.%uuid of player%} is not set:
                set {aizensmp.shards.%uuid of player%} to 0
            send "%{@prefix}% &fYour balance: &b%{aizensmp.shards.%uuid of player%}% ✦" to player
            send "&7Use &b/shard shop &7to open the Spawner Shop." to player
            stop

        if arg-1 is "shop":
            open chest inventory with 3 rows named "&8✦ &bSpawner Shard Shop &8✦" to player
            wait 1 tick

            set slot 10 of player's current inventory to spawner named "&aZombie Spawner &7- &e500 ✦"
            set slot 12 of player's current inventory to spawner named "&cSkeleton Spawner &7- &e2,000 ✦"
            set slot 14 of player's current inventory to spawner named "&6Blaze Spawner &7- &e3,000 ✦"
            set slot 16 of player's current inventory to spawner named "&5Enderman Spawner &7- &e3,500 ✦"
            set slot 22 of player's current inventory to spawner named "&bIron Golem Spawner &7- &e10,000 ✦"
            stop

        if arg-1 is "give":
            if player has permission "aizensmp.admin":
                if arg-2 is not set:
                    send "%{@prefix}% &cUsage: /shard give <amount>" to player
                    stop
                if arg-2 <= 0:
                    send "%{@prefix}% &cAmount must be positive." to player
                    stop
                add arg-2 to {aizensmp.shards.%uuid of player%}
                send "%{@prefix}% &aAdded &b%arg-2% ✦ &ato your Shards." to player
                stop

        send "%{@prefix}% &cUnknown shard command." to player

on inventory click:
    if name of event-inventory is "&8✦ &bSpawner Shard Shop &8✦":
        cancel event

        if clicked slot is 10:
            set {_price} to 500
            set {_name} to "Zombie"
        else if clicked slot is 12:
            set {_price} to 2000
            set {_name} to "Skeleton"
        else if clicked slot is 14:
            set {_price} to 3000
            set {_name} to "Blaze"
        else if clicked slot is 16:
            set {_price} to 3500
            set {_name} to "Enderman"
        else if clicked slot is 22:
            set {_price} to 10000
            set {_name} to "Iron Golem"
        else:
            stop

        if {aizensmp.shards.%uuid of player%} < {_price}:
            send "%{@prefix}% &cYou need &b%{_price}% ✦ &cto buy this spawner." to player
            stop

        if player's inventory has no space for 1 spawner:
            send "%{@prefix}% &cYour inventory is full." to player
            stop

        remove {_price} from {aizensmp.shards.%uuid of player%}
        give 1 spawner to player
        send "%{@prefix}% &aPurchased a &e%{_name}% Spawner &afor &b%{_price}% ✦&a." to player

on death of player:
    if attacker is a player:
        add 10 to {aizensmp.shards.%uuid of attacker%}
        send "%{@prefix}% &aKill reward: &b+10 ✦" to attacker

command /setafk:
    permission: aizensmp.admin
    trigger:
        set {aizensmp.afk.location} to location of player
        send "%{@prefix}% &aAFK location set." to player

command /afk:
    trigger:
        if {aizensmp.afk.location} is not set:
            send "%{@prefix}% &cThe AFK location has not been set yet." to player
            stop
        teleport player to {aizensmp.afk.location}
        send "%{@prefix}% &aYou have been teleported to the AFK area." to player

every 1 minute:
    loop all players:
        if {aizensmp.afk.location} is set:
            if distance between loop-player and {aizensmp.afk.location} <= 3:
                add 1 to {aizensmp.shards.%uuid of loop-player%}
                send "%{@prefix}% &aAFK reward: &b+1 ✦" to loop-player

on first join:
    if {aizensmp.shards.%uuid of player%} is not set:
        set {aizensmp.shards.%uuid of player%} to 0

on join:
    if {aizensmp.shards.%uuid of player%} is not set:
        set {aizensmp.shards.%uuid of player%} to 0
