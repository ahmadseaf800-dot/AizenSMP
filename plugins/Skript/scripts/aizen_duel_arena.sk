# =========================================================
# AIZEN SMP - READY DUEL ARENA BUILDER
# Purpur 1.21.11 / Skript
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r
    arena-radius: 37
    arena-size: 75

function azBuildDuelArena(p: player):
    set {az.duel.arena} to location of {_p}
    set {az.duel.spawn1} to location of {_p}
    set {az.duel.spawn2} to location of {_p}
    add -12 to x-coordinate of {az.duel.spawn1}
    add 2 to y-coordinate of {az.duel.spawn1}
    add 12 to x-coordinate of {az.duel.spawn2}
    add 2 to y-coordinate of {az.duel.spawn2}
    set {_s} to {az.duel.arena}
    # Clear the 75x75 playable arena volume.
    execute console command "execute at %{_p}% run fill ~-37 ~-1 ~-37 ~37 ~15 ~37 air"
    # Main floor.
    execute console command "execute at %{_p}% run fill ~-37 ~-2 ~-37 ~37 ~-2 ~37 polished_blackstone"
    execute console command "execute at %{_p}% run fill ~-34 ~-1 ~-34 ~34 ~-1 ~34 black_concrete"
    # Gold cross and center.
    execute console command "execute at %{_p}% run fill ~-2 ~0 ~-34 ~2 ~0 ~34 gold_block"
    execute console command "execute at %{_p}% run fill ~-34 ~0 ~-2 ~34 ~0 ~2 gold_block"
    execute console command "execute at %{_p}% run fill ~-6 ~0 ~-6 ~6 ~0 ~6 quartz_block"
    execute console command "execute at %{_p}% run fill ~-3 ~1 ~-3 ~3 ~1 ~3 gold_block"
    execute console command "execute at %{_p}% run fill ~-2 ~2 ~-2 ~2 ~2 ~2 beacon"
    # Four arena towers.
    execute console command "execute at %{_p}% run fill ~-35 ~0 ~-35 ~-29 ~10 ~-29 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~29 ~0 ~-35 ~35 ~10 ~-29 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~-35 ~0 ~29 ~-29 ~10 ~35 polished_blackstone_bricks"
    execute console command "execute at %{_p}% run fill ~29 ~0 ~29 ~35 ~10 ~35 polished_blackstone_bricks"
    # Boundary pillars and gold caps.
    execute console command "execute at %{_p}% run fill ~-37 ~0 ~-37 ~-36 ~7 ~-36 blackstone"
    execute console command "execute at %{_p}% run fill ~36 ~0 ~-37 ~37 ~7 ~-36 blackstone"
    execute console command "execute at %{_p}% run fill ~-37 ~0 ~36 ~-36 ~7 ~37 blackstone"
    execute console command "execute at %{_p}% run fill ~36 ~0 ~36 ~37 ~7 ~37 blackstone"
    execute console command "execute at %{_p}% run fill ~-37 ~8 ~-37 ~-36 ~8 ~-36 gold_block"
    execute console command "execute at %{_p}% run fill ~36 ~8 ~-37 ~37 ~8 ~-36 gold_block"
    execute console command "execute at %{_p}% run fill ~-37 ~8 ~36 ~-36 ~8 ~37 gold_block"
    execute console command "execute at %{_p}% run fill ~36 ~8 ~36 ~37 ~8 ~37 gold_block"
    # Four player pads and two duel spawn platforms.
    execute console command "execute at %{_p}% run fill ~-16 ~0 ~-4 ~-10 ~0 ~4 quartz_block"
    execute console command "execute at %{_p}% run fill ~10 ~0 ~-4 ~16 ~0 ~4 quartz_block"
    execute console command "execute at %{_p}% run fill ~-4 ~0 ~-16 ~4 ~0 ~-10 quartz_block"
    execute console command "execute at %{_p}% run fill ~-4 ~0 ~10 ~4 ~0 ~16 quartz_block"
    execute console command "execute at %{_p}% run fill ~-15 ~1 ~-3 ~-9 ~1 ~3 gold_block"
    execute console command "execute at %{_p}% run fill ~9 ~1 ~-3 ~15 ~1 ~3 gold_block"
    set {az.duel.spawn1} to location of {_p}
    set {az.duel.spawn2} to location of {_p}
    add -12 to x-coordinate of {az.duel.spawn1}
    add 2 to y-coordinate of {az.duel.spawn1}
    add 12 to x-coordinate of {az.duel.spawn2}
    add 2 to y-coordinate of {az.duel.spawn2}
    set {az.duel.arena.built} to true
    send "{@prefix}&aتم بناء Duel Arena بمقاس 75x75." to {_p}
    send "{@prefix}&7التكسير والبناء مسموحان أثناء الفايت، والخروج من النطاق ممنوع." to {_p}

command /buildduelarena:
    permission: aizensmp.admin
    aliases: /buildduel
    trigger:
        azBuildDuelArena(player)

command /setduel:
    permission: aizensmp.admin
    trigger:
        set {az.duel.arena} to location of player
        set {az.duel.spawn1} to location of player
        set {az.duel.spawn2} to location of player
        add -12 to x-coordinate of {az.duel.spawn1}
        add 2 to y-coordinate of {az.duel.spawn1}
        add 12 to x-coordinate of {az.duel.spawn2}
        add 2 to y-coordinate of {az.duel.spawn2}
        delete {az.duel.arena.built}
        send "{@prefix}&aتم تحديد مركز Duel Arena هنا."
        send "{@prefix}&7لتجهيز البناء استخدم &e/buildduelarena"

on join:
    if {az.duel.arena} is not set:
        if {az.spawn} is set:
            set {az.duel.arena} to {az.spawn}


# ---------------- DUEL POSITION SETUP ----------------
# Set the exact duel center, player 1 spawn and player 2 spawn independently.
command /setduelspawn:
    permission: aizensmp.admin
    trigger:
        set {az.duel.arena} to location of player
        delete {az.duel.arena.built}
        send "{@prefix}&aتم تحديد مركز Arena هنا." to player

command /setduelplayer1:
    permission: aizensmp.admin
    trigger:
        set {az.duel.spawn1} to location of player
        send "{@prefix}&aتم تحديد Spawn اللاعب الأول هنا." to player

command /setduelplayer2:
    permission: aizensmp.admin
    trigger:
        set {az.duel.spawn2} to location of player
        send "{@prefix}&aتم تحديد Spawn اللاعب الثاني هنا." to player

command /duelpositions:
    permission: aizensmp.admin
    trigger:
        send "&8&m--------------------------------"
        send "&6&lAIZEN DUEL POSITIONS"
        send "&eArena: &f%{az.duel.arena}%"
        send "&ePlayer 1: &f%{az.duel.spawn1}%"
        send "&ePlayer 2: &f%{az.duel.spawn2}%"
        send "&8&m--------------------------------"
