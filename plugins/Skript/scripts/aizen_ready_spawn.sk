# =========================================================
# AizenSMP - READY SPAWN BUILDER
# Purpur 1.21.11 / Skript
# Builds a Donut-style compact spawn with central plaza,
# four towers, paths and NPC pedestals.
# =========================================================

command /buildreadyspawn:
    permission: aizensmp.admin
    trigger:
        set {_c} to location of player
        set {_w} to world of player

        # Put the player safely at the center and save spawn.
        set {az.spawn} to {_c}
        set {az.afk} to {_c}
        add 2 to y-coordinate of {_c}

        # Clear a 41x41x15 area.
        set {_a} to {_c}
        set {_b} to {_c}
        subtract 20 from x-coordinate of {_a}
        subtract 7 from y-coordinate of {_a}
        subtract 20 from z-coordinate of {_a}
        add 20 to x-coordinate of {_b}
        add 8 to y-coordinate of {_b}
        add 20 to z-coordinate of {_b}
        set blocks within {_a} and {_b} to air

        # Main floor.
        set {_a} to {_c}
        set {_b} to {_c}
        subtract 20 from x-coordinate of {_a}
        subtract 1 from y-coordinate of {_a}
        subtract 20 from z-coordinate of {_a}
        add 20 to x-coordinate of {_b}
        subtract 1 from y-coordinate of {_b}
        add 20 to z-coordinate of {_b}
        set blocks within {_a} and {_b} to polished deepslate

        # Gold/black central plaza.
        set {_a} to {_c}
        set {_b} to {_c}
        subtract 9 from x-coordinate of {_a}
        add 0 to y-coordinate of {_a}
        subtract 9 from z-coordinate of {_a}
        add 9 to x-coordinate of {_b}
        add 0 to y-coordinate of {_b}
        add 9 to z-coordinate of {_b}
        set blocks within {_a} and {_b} to blackstone

        # Gold cross paths.
        set {_a} to {_c}
        set {_b} to {_c}
        subtract 20 from x-coordinate of {_a}
        add 1 to y-coordinate of {_a}
        subtract 2 from z-coordinate of {_a}
        add 20 to x-coordinate of {_b}
        add 1 to y-coordinate of {_b}
        add 2 to z-coordinate of {_b}
        set blocks within {_a} and {_b} to smooth quartz

        set {_a} to {_c}
        set {_b} to {_c}
        subtract 2 from x-coordinate of {_a}
        add 1 to y-coordinate of {_a}
        subtract 20 from z-coordinate of {_a}
        add 2 to x-coordinate of {_b}
        add 1 to y-coordinate of {_b}
        add 20 to z-coordinate of {_b}
        set blocks within {_a} and {_b} to smooth quartz

        # Central gold platform.
        set {_a} to {_c}
        set {_b} to {_c}
        subtract 6 from x-coordinate of {_a}
        add 1 to y-coordinate of {_a}
        subtract 6 from z-coordinate of {_a}
        add 6 to x-coordinate of {_b}
        add 1 to y-coordinate of {_b}
        add 6 to z-coordinate of {_b}
        set blocks within {_a} and {_b} to gold block

        # Four black/gold towers.
        loop 4 times:
            if loop-number is 1:
                set {_tx} to -16
                set {_tz} to -16
            else if loop-number is 2:
                set {_tx} to 16
                set {_tz} to -16
            else if loop-number is 3:
                set {_tx} to -16
                set {_tz} to 16
            else:
                set {_tx} to 16
                set {_tz} to 16

            set {_a} to {_c}
            set {_b} to {_c}
            add {_tx} to x-coordinate of {_a}
            add {_tz} to z-coordinate of {_a}
            add 1 to y-coordinate of {_a}
            add {_tx} to x-coordinate of {_b}
            add {_tz} to z-coordinate of {_b}
            add 8 to y-coordinate of {_b}
            set blocks within {_a} and {_b} to polished blackstone bricks

            set {_a} to {_c}
            set {_b} to {_c}
            add {_tx} to x-coordinate of {_a}
            add {_tz} to z-coordinate of {_a}
            add 9 to y-coordinate of {_a}
            add {_tx} to x-coordinate of {_b}
            add {_tz} to z-coordinate of {_b}
            add 10 to y-coordinate of {_b}
            set blocks within {_a} and {_b} to gold block

        # Four service pedestals for NPCs.
        set {_a} to {_c}
        set {_b} to {_c}
        subtract 4 from x-coordinate of {_a}
        add 2 to y-coordinate of {_a}
        subtract 4 from z-coordinate of {_a}
        add 4 to x-coordinate of {_b}
        add 2 to y-coordinate of {_b}
        add 4 to z-coordinate of {_b}
        set blocks within {_a} and {_b} to gold block

        # Lighting around the plaza.
        set {_a} to {_c}
        set {_b} to {_c}
        subtract 8 from x-coordinate of {_a}
        add 2 to y-coordinate of {_a}
        subtract 8 from z-coordinate of {_a}
        add 8 to x-coordinate of {_b}
        add 2 to y-coordinate of {_b}
        add 8 to z-coordinate of {_b}
        replace all gold block in blocks within {_a} and {_b} with sea lantern

        # Spawn point above the center.
        set {az.spawn} to {_c}
        set {az.afk} to {_c}

        send "{@prefix} &aReady Spawn built successfully." to player
        send "{@prefix} &7Center: &f%{az.spawn}%" to player
        send "{@prefix} &eNPCs can be placed around the four central pedestals." to player
        send "{@prefix} &7Use &f/setrtpbot, /setshop, /setduelbot, /setahbot &7while standing where you want each NPC." to player
