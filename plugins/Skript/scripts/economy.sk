# =========================================================
# AizenSMP - Basic Economy + Richest Sign
# Money variable: {aizensmp.money.<uuid>}
# =========================================================

options:
    prefix: &6[&eAizenSMP&6] &r

command /balance:
    aliases: /bal
    trigger:
        if {aizensmp.money.%uuid of player%} is not set:
            set {aizensmp.money.%uuid of player%} to 0
        send "%{@prefix}% &fBalance: &6$%{aizensmp.money.%uuid of player%}%" to player

command /pay <player> <number>:
    trigger:
        if {aizensmp.settings.pay.%uuid of arg-1%} is "none":
            send "%{@prefix}% &cThat player has disabled payments." to player
            stop
        if {aizensmp.settings.pay.%uuid of arg-1%} is "friends":
            if {aizensmp.friend.%uuid of arg-1%.%uuid of player%} is not true:
                send "%{@prefix}% &cOnly that player's friends can make a payment." to player
                stop
        if arg-1 is player:
            send "%{@prefix}% &cYou cannot pay yourself." to player
            stop
        if arg-2 <= 0:
            send "%{@prefix}% &cAmount must be positive." to player
            stop
        if {aizensmp.money.%uuid of player%} < arg-2:
            send "%{@prefix}% &cYou don't have enough money." to player
            stop
        remove arg-2 from {aizensmp.money.%uuid of player%}
        add arg-2 to {aizensmp.money.%uuid of arg-1%}
        send "%{@prefix}% &aPaid &6$%arg-2% &ato &e%arg-1%&a." to player
        send "%{@prefix}% &aYou received &6$%arg-2% &afrom &e%player%&a." to arg-1

command /setrichsign:
    permission: aizensmp.admin
    permission message: &cYou don't have permission.
    trigger:
        set {aizensmp.richsign.location} to location of player
        send "%{@prefix}% &aRichest-players sign location set." to player

on join:
    if {aizensmp.money.%uuid of player%} is not set:
        set {aizensmp.money.%uuid of player%} to 0
    set {aizensmp.money.name.%uuid of player%} to name of player

every 1 minute:
    if {aizensmp.richsign.location} is set:
        set {_best1} to ""
        set {_best2} to ""
        set {_best3} to ""
        set {_v1} to -1
        set {_v2} to -1
        set {_v3} to -1
        loop {aizensmp.money::*}:
            if loop-index does not contain ".name.":
                if loop-value is a number:
                    if loop-value > {_v1}:
                        set {_v3} to {_v2}
                        set {_best3} to {_best2}
                        set {_v2} to {_v1}
                        set {_best2} to {_best1}
                        set {_v1} to loop-value
                        set {_best1} to loop-index
                    else if loop-value > {_v2}:
                        set {_v3} to {_v2}
                        set {_best3} to {_best2}
                        set {_v2} to loop-value
                        set {_best2} to loop-index
                    else if loop-value > {_v3}:
                        set {_v3} to loop-value
                        set {_best3} to loop-index
        set line 1 of block at {aizensmp.richsign.location} to "&6&lRICH"
        if {_best1} is not "":
            set line 2 of block at {aizensmp.richsign.location} to "&e1. %{aizensmp.money.name.%{_best1}%}%"
            set line 3 of block at {aizensmp.richsign.location} to "&6$%{_v1}%"
        else:
            set line 2 of block at {aizensmp.richsign.location} to "&7No players"
            set line 3 of block at {aizensmp.richsign.location} to "&60$"
        if {_best2} is not "":
            set line 4 of block at {aizensmp.richsign.location} to "&f2. %{aizensmp.money.name.%{_best2}%}%"
        else:
            set line 4 of block at {aizensmp.richsign.location} to "&7Come back later"
